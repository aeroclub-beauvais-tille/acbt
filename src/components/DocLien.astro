---
import { asset, dateFr } from '../lib/utils';
import { titreDoc, etatValidite } from '../lib/documents';
interface Props {
  doc: { titre?: string; type?: string; avions?: string[]; fichier?: string; lien?: string; description?: string; mis_a_jour?: Date; debut?: Date; fin?: Date };
  court?: string;
  // Affiche un badge de validité (valide / expire / expiré), recalculé dans le navigateur.
  badge?: boolean;
  // Onglet vers lequel renvoie l'alerte d'expiration (ex. « avions », « club »).
  vers?: string;
}
const { doc, court, badge, vers } = Astro.props;
const titre = titreDoc(doc);
const cible = doc.fichier ? asset(doc.fichier) : doc.lien || '';
const ext = (doc.fichier || '').split('?')[0].split('.').pop()?.toLowerCase() || '';
const type = doc.fichier
  ? (['xls', 'xlsx', 'ods', 'csv'].includes(ext) ? 'XLS' : ['doc', 'docx', 'odt'].includes(ext) ? 'DOC' : ['mp4', 'mov', 'webm'].includes(ext) ? 'VIDÉO' : 'PDF')
  : /youtu|vimeo/.test(doc.lien || '') ? 'VIDÉO' : 'LIEN';
const recherche = `${titre} ${doc.type ?? ''} ${doc.description ?? ''}`.toLowerCase();

// Badge de validité : repli calculé au build (le navigateur le remet à jour pour rester juste hors ligne).
const avecBadge = badge || !!(doc.debut || doc.fin || doc.type);
const e = avecBadge ? etatValidite(doc) : null;
const repli = !e ? '' : e.code === 'sans-fin' ? 'N’expire pas'
  : e.code === 'a-venir' ? `Valide à partir du ${doc.debut ? dateFr(doc.debut) : ''}`
  : e.code === 'expire' ? `Expiré le ${doc.fin ? dateFr(doc.fin) : ''}`
  : e.code === 'bientot' ? `Expire dans ${e.jours} jour${(e.jours ?? 0) > 1 ? 's' : ''}`
  : `Valide jusqu’au ${doc.fin ? dateFr(doc.fin) : ''}`;
const dataBadge = avecBadge ? {
  'data-fin': doc.fin ? doc.fin.toISOString().slice(0, 10) : undefined,
  'data-debut': doc.debut ? doc.debut.toISOString().slice(0, 10) : undefined,
  'data-titre': titre,
  'data-vers': vers,
} : {};
---
{cible ? (
  <a class="doc" href={cible} target="_blank" rel="noopener" data-q={recherche}>
    <span class:list={['type', `t-${type.toLowerCase().replace('é', 'e')}`]}>{type}</span>
    <span class="txt">
      <strong>{court ?? titre}</strong>
      {doc.description && <span class="meta">{doc.description}</span>}
      {!avecBadge && doc.mis_a_jour && <span class="meta">Mis à jour le {dateFr(doc.mis_a_jour)}</span>}
      {avecBadge && <span class="badge" data-code={e?.code} {...dataBadge}>{repli}</span>}
    </span>
  </a>
) : (
  <span class="doc vide" data-q={recherche} title="Document pas encore déposé">
    <span class="type">…</span>
    <span class="txt">
      <strong>{court ?? titre}</strong>
      {avecBadge
        ? <span class="badge" data-code={e?.code} {...dataBadge}>{repli}</span>
        : <span class="meta">Bientôt disponible</span>}
    </span>
  </span>
)}
<style>
  .doc { display: flex; gap: 12px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  a.doc:hover { border-color: var(--accent); transform: translateY(-1px); }
  .doc strong { font-weight: 600; font-size: .95rem; line-height: 1.3; display: block; }
  .doc .meta { display: block; font-size: .8rem; }
  .type { flex: none; min-width: 44px; text-align: center; font-weight: 700; font-size: .68rem; letter-spacing: .04em; padding: 6px 6px; border-radius: 6px; background: var(--line); color: var(--muted); }
  .t-pdf { background: #fbe9e7; color: #c0392b; }
  .t-xls { background: #e6f4ea; color: #1e7e34; }
  .t-doc { background: #e8f0fe; color: #2f6fd6; }
  .t-video { background: #f3e8ff; color: #6b4fbb; }
  .t-lien { background: color-mix(in srgb, var(--accent) 14%, white); color: var(--accent); }
  .vide { opacity: .65; border-style: dashed; }
  /* Badge de validité */
  .badge { display: inline-flex; align-items: center; gap: 6px; margin-top: 5px; font-size: .78rem; font-weight: 600; padding: 2px 10px 2px 8px; border-radius: 999px; border: 1px solid; }
  .badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .badge[data-code='valide'], .badge[data-code='sans-fin'] { color: #1e7e34; background: #e8f6ec; border-color: #bfe3c8; }
  .badge[data-code='bientot'] { color: #9a6200; background: #fff3dd; border-color: #f2d49a; }
  .badge[data-code='expire'] { color: #b42318; background: #fdecea; border-color: #f3b4ad; }
  .badge[data-code='a-venir'] { color: #475467; background: #eef1f6; border-color: #cfd6e2; }
</style>
