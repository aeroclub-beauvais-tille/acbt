---
// Statistiques de fréquentation du site (acbt60.fr/statistiques/), réservées à l'admin.
// Les chiffres viennent du compteur sans cookies (functions/_visites.js) via /api/statistiques.
import MembreApp from '../../layouts/MembreApp.astro';
import Logo from '../../components/Logo.astro';
import { url } from '../../lib/utils';
---
<MembreApp title="Statistiques du site" description="Fréquentation du site de l'aéroclub (réservé à l'admin).">
  <div class="ecran" id="ecran" data-api={url('/api/statistiques')}>
    <header class="haut">
      <a href={url('/')} class="retour" aria-label="Retour au site">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
      </a>
      <Logo class="logo" />
      <span>Statistiques du site</span>
      <b class="direct" id="direct" hidden></b>
    </header>

    <main class="corps">
      <form class="carte connexion" id="connexion" hidden>
        <h2>Accès admin</h2>
        <label for="mdp">Mot de passe admin</label>
        <input id="mdp" type="password" autocomplete="current-password" required />
        <p class="erreur" id="erreur" role="alert" hidden></p>
        <button class="pri" type="submit">Voir les statistiques</button>
      </form>

      <div id="contenu" hidden>
        <div class="filtres">
          <div class="seg" role="tablist" aria-label="Partie du site" id="f-section">
            <button type="button" data-v="vitrine" aria-pressed="true">Site public</button>
            <button type="button" data-v="membre" aria-pressed="false">Espace membre</button>
            <button type="button" data-v="perfs" aria-pressed="false">Perfs</button>
          </div>
          <div class="seg" aria-label="Période" id="f-jours">
            <button type="button" data-v="7" aria-pressed="false">7 jours</button>
            <button type="button" data-v="30" aria-pressed="true">30 jours</button>
            <button type="button" data-v="90" aria-pressed="false">3 mois</button>
            <button type="button" data-v="365" aria-pressed="false">12 mois</button>
          </div>
        </div>

        <section class="tuiles" id="tuiles"></section>
        <p class="sous parties" id="parties"></p>

        <section class="carte">
          <div class="tete"><h2 id="g-titre">Visiteurs par jour</h2>
            <span class="legende" id="g-legende"><span><i class="sw"></i>Visiteurs</span><span><i class="sw ligne"></i>Tendance (moyenne sur 7 jours)</span></span></div>
          <div class="graphe" id="graphe" data-c="bleu"></div>
        </section>

        <div class="vitrine-seul grille">
          <section class="carte"><h2>Ce que font les visiteurs</h2><ol class="actions" id="l-actions"></ol>
            <p class="sous note">Un « clic Réserver » ouvre le formulaire ; une « demande » est un formulaire réellement envoyé au club.</p></section>
          <section class="carte"><h2 id="g2-titre">Clics sur Réserver par jour</h2><div class="graphe petit" id="graphe2" data-c="rouge"></div></section>
          <section class="carte"><h2>Demandes envoyées, par objet</h2><ol class="barres" id="l-demandes" data-c="rouge"></ol></section>
          <section class="carte"><h2>Pages d’où l’on clique sur Réserver</h2><ol class="barres" id="l-reserver" data-c="rouge"></ol></section>
          <section class="carte"><h2>Liens cliqués vers d’autres sites</h2><ol class="barres" id="l-sorties" data-c="ciel"></ol></section>
          <section class="carte"><h2>Documents ouverts</h2><ol class="barres" id="l-documents" data-c="marine"></ol></section>
        </div>

        <div class="grille">
          <section class="carte"><h2>À quelle heure</h2><div class="graphe petit" id="g-heures" data-c="ciel"></div></section>
          <section class="carte"><h2>Quel jour de la semaine</h2><div class="graphe petit" id="g-semaine" data-c="bleu"></div></section>
          <section class="carte"><h2>Pages les plus vues</h2><ol class="barres" id="l-pages" data-c="bleu"></ol></section>
          <section class="carte"><h2>Page d’arrivée sur le site</h2><ol class="barres" id="l-entrees" data-c="ciel"></ol></section>
          <section class="carte"><h2>D’où viennent les visiteurs</h2><ol class="barres" id="l-sources" data-c="ciel"></ol>
            <p class="sous note">« Direct » : adresse tapée, favori, lien dans un mail ou une appli qui ne dit pas d’où il vient.</p></section>
          <section class="carte vitrine-seul"><h2>Pages lues le plus longtemps</h2><ol class="barres" id="l-temps" data-c="marine"></ol>
            <p class="sous note">Temps moyen passé sur la page, onglet visible.</p></section>
          <section class="carte"><h2>Appareils</h2><div class="donut" id="d-appareils"></div></section>
          <section class="carte"><h2>Villes</h2><ol class="barres" id="l-villes" data-c="bleu"></ol>
            <p class="sous note">Ville approximative, déduite du fournisseur d’accès.</p></section>
        </div>

        <p class="sous pied-note" id="pied-note">Compté sans cookies et sans donnée personnelle. Un visiteur est reconnu le jour même seulement : s’il revient un autre jour, il compte de nouveau. Les robots et moteurs de recherche sont écartés.</p>
        <button class="lien" type="button" id="oublier">Se déconnecter de cette page</button>
      </div>
    </main>
  </div>
</MembreApp>

<script>
  const API = document.getElementById('ecran')!.dataset.api!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const CLE = 'acbt-admin-stats';
  type Ligne = Record<string, string | number | null>;
  type Jour = { k: string; vues: number; visiteurs: number; clics: number; demandes: number; appels: number };
  type Stats = {
    jours: number; section: string; parMois: boolean; depuis: string | null; enDirect: number;
    totaux: Ligne[]; precedent: Ligne[]; serie: Jour[]; heures: number[]; semaine: number[];
    rebond: { seuls: number; tous: number }; entrees: Ligne[];
    actions: Ligne[]; actionsAvant: Ligne[]; details: Ligne[]; pagesReserver: Ligne[]; tempsTotal: number; tempsPages: Ligne[];
    pages: Ligne[]; sources: Ligne[]; appareils: Ligne[]; villes: Ligne[];
  };
  type Point = { v: number; x?: string; bulle: string };
  const etat = { section: 'vitrine', jours: 30, mdp: '' };
  try { etat.mdp = localStorage.getItem(CLE) || localStorage.getItem('acbt-admin-alertes') || ''; } catch { /* privé */ }

  const esc = (t: unknown) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const nb = (n: number) => Math.round(n).toLocaleString('fr-FR');
  const duree = (s: number) => (s < 60 ? `${Math.round(s)} s` : `${Math.floor(s / 60)} min ${String(Math.round(s % 60)).padStart(2, '0')}`);
  const NOMS: Record<string, string> = {
    '/': 'Accueil', '/decouvrir-le-vol/': 'Baptême / découvrir le vol', '/formations/': 'Formations', '/club/': 'Le club',
    '/club/flotte/': 'La flotte', '/club/tarifs/': 'Tarifs', '/club/historique/': 'Histoire du club', '/actualites/': 'Actualités',
    '/contact/': 'Contact', '/mentions-legales/': 'Mentions légales', '/membre/': 'Accueil de l’appli', '/membre/connexion/': 'Connexion',
    '/membre/admin/': 'Administration', '/membre/messages/': 'Messages du club', '/membre/alertes-meteo/': 'Alertes météo',
    '/membre/signalements/': 'Signalements', '/membre/perfs/': 'Perfs ACBT',
  };
  const nomPage = (p: string) => NOMS[p] || (p.startsWith('/actualites/') ? 'Actu : ' + p.slice(12, -1).replace(/-/g, ' ') : p);
  const APPAREILS: Record<string, string> = { telephone: 'Téléphone', ordinateur: 'Ordinateur', tablette: 'Tablette', tv: 'Télévision' };
  const ACTIONS: [string, string][] = [
    ['clic-contact', 'Clics sur « Réserver » / « Contact »'], ['formulaire', 'Demandes envoyées (formulaire)'],
    ['appel', 'Clics sur le numéro de téléphone'], ['mail', 'Clics sur l’adresse e-mail'],
    ['sortie', 'Liens vers d’autres sites (Facebook…)'], ['document', 'Documents ouverts'], ['formulaire-erreur', 'Formulaires en échec'],
  ];
  const PAYS = new Intl.DisplayNames(['fr'], { type: 'region' });
  const SECTIONS: Record<string, string> = { vitrine: 'Site public', membre: 'Espace membre', perfs: 'Perfs' };
  const JOURS = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];

  function barres(el: HTMLElement, lignes: Ligne[], nom: (l: Ligne) => string, val: string, unite: string, fmt = nb) {
    if (!lignes.length) { el.innerHTML = '<li class="vide">Pas encore de données.</li>'; return; }
    const max = Math.max(...lignes.map((l) => Number(l[val]) || 0), 1);
    el.innerHTML = lignes.map((l, i) => {
      const n = Number(l[val]) || 0;
      return `<li title="${esc(nom(l))} : ${fmt(n)} ${unite}" style="--i:${i}"><span class="b" style="width:${(n / max) * 100}%"></span><span class="t">${esc(nom(l))}</span><span class="n">${fmt(n)}</span></li>`;
    }).join('');
  }

  function ecart(a: number, b: number, avec = true) {
    if (!avec) return '';
    if (!b) return a ? '<span class="ev">nouveau</span>' : '';
    const p = Math.round(((a - b) / b) * 100);
    return `<span class="ev ${p > 0 ? 'up' : p < 0 ? 'down' : ''}">${p > 0 ? '+' : ''}${p} %</span>`;
  }

  /** Histogramme à une série, avec en option une courbe de tendance (moyenne glissante). */
  function graphe(el: HTMLElement, pts: Point[], tendance?: (number | null)[]) {
    const max = Math.max(...pts.map((x) => x.v), ...(tendance || []).map((x) => x || 0), 1);
    const pas = Math.pow(10, Math.floor(Math.log10(max)));
    const haut = Math.max(Math.ceil(max / pas) * pas, 2);
    const n = pts.length;
    let ligne = '';
    if (tendance && tendance.some((x) => x != null)) {
      const seg = tendance.map((y, i) => (y == null ? null : `${((i + 0.5) / n) * 100},${100 - (y / haut) * 100}`));
      const d = seg.reduce((acc, p, i) => (p == null ? acc : acc + (seg[i - 1] == null ? ` M${p}` : ` L${p}`)), '');
      ligne = `<svg class="tendance" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="${d}" /></svg>`;
    }
    el.innerHTML = `<div class="axe"><span>${nb(haut)}</span><span>${nb(haut / 2)}</span><span>0</span></div>
      <div class="zone" style="--n:${n}">${pts.map((x, i) => `<div class="col" style="--i:${Math.round((i / n) * 40)}" tabindex="0" aria-label="${esc(x.bulle.replace(/<[^>]+>/g, ' '))}">
        <span class="bar" style="height:${(x.v / haut) * 100}%"></span>
        <span class="bulle">${x.bulle}</span>
        ${x.x ? `<span class="x">${esc(x.x)}</span>` : ''}</div>`).join('')}${ligne}</div>`;
  }

  const moyenne7 = (v: number[]) => v.map((_, i) => (i < 6 ? null : v.slice(i - 6, i + 1).reduce((a, b) => a + b, 0) / 7));
  function etiquettes(el: HTMLElement, s: Jour[], parMois: boolean) {
    const fmt = (k: string) => parMois
      ? new Date(k + '-15').toLocaleDateString('fr-FR', { month: 'short', year: '2-digit' })
      : new Date(k + 'T12:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
    const pas = Math.ceil(s.length / (el.clientWidth < 500 ? 4 : (parMois ? 12 : 6)));
    return s.map((x, i) => ({ nom: fmt(x.k), x: s.length <= 7 || i % pas === 0 || (i === s.length - 1 && i % pas >= pas / 2) ? fmt(x.k) : '' }));
  }

  const ICONES: Record<string, string> = {
    gens: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.6"/><path d="M17 14c2.6 0 4.5 1.8 4.5 4.5"/>',
    page: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
    horloge: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    pile: '<rect x="4" y="4" width="12" height="14" rx="2"/><path d="M8 21h10a2 2 0 0 0 2-2V8"/>',
    sortie: '<path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M15 16l4-4-4-4M19 12H9"/>',
    clic: '<path d="M9 9l11 4-4.5 1.5L14 19z"/><path d="M5 3v3M3 5h3M5.5 9.5 3.5 11.5M9.5 5.5l2-2"/>',
    envoi: '<path d="M21 3 10 14"/><path d="M21 3 14 21l-4-7-7-4z"/>',
  };
  const COUL_APP: Record<string, string> = { telephone: 'bleu', ordinateur: 'ciel', tablette: 'marine', tv: 'rouge' };

  function donut(el: HTMLElement, parts: { nom: string; v: number; c: string }[]) {
    const tot = parts.reduce((a, b) => a + b.v, 0);
    if (!tot) { el.innerHTML = '<p class="vide">Pas encore de données.</p>'; return; }
    let cumul = 0;
    const arcs = parts.map((x, i) => {
      const part = (x.v / tot) * 100;
      const arc = `<circle class="arc" data-c="${x.c}" cx="21" cy="21" r="15.915" pathLength="100" style="--p:${Math.max(part - 0.8, 0.1)};--d:${-cumul};--i:${i}" />`;
      cumul += part;
      return arc;
    }).join('');
    const top = parts[0];
    el.innerHTML = `<svg viewBox="0 0 42 42" class="anneau" aria-hidden="true"><circle class="fond" cx="21" cy="21" r="15.915" />${arcs}
      <text x="21" y="20.5" class="pc">${Math.round((top.v / tot) * 100)} %</text><text x="21" y="26" class="pn">${esc(top.nom.toLowerCase())}</text></svg>
      <ul class="leg">${parts.map((x) => `<li><i data-c="${x.c}"></i><span>${esc(x.nom)}</span><b>${nb(x.v)}</b><em>${Math.round((x.v / tot) * 100)} %</em></li>`).join('')}</ul>`;
  }

  const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function compter(racine: HTMLElement) {
    if (calme) return;
    racine.querySelectorAll<HTMLElement>('[data-compte]').forEach((el) => {
      const fin = Number(el.dataset.compte), fmt = el.dataset.fmt;
      const f = (x: number) => (fmt === 'duree' ? duree(x) : fmt === 'pct' ? `${Math.round(x)} %` : nb(x));
      const t0 = performance.now(), D = 900;
      const pas = (t: number) => {
        const k = Math.min(1, (t - t0) / D);
        el.textContent = f(fin * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(pas);
      };
      requestAnimationFrame(pas);
    });
  }

  function afficher(d: Stats) {
    const vitrine = d.section === 'vitrine';
    document.querySelectorAll<HTMLElement>('.vitrine-seul').forEach((x) => { x.hidden = !vitrine; });
    const t = d.totaux.find((x) => x.section === d.section) || { vues: 0, visiteurs: 0 };
    const p = d.precedent.find((x) => x.section === d.section) || { vues: 0, visiteurs: 0 };
    const vis = Number(t.visiteurs), vues = Number(t.vues);
    const comparer = !(d.depuis && new Date(d.depuis) > new Date(Date.now() - 2 * d.jours * 864e5));
    const act = (e: string, champ = 'n') => Number(d.actions.find((x) => x.e === e)?.[champ] || 0);
    const actAvant = (e: string) => Number(d.actionsAvant.find((x) => x.e === e)?.n || 0);
    const rebond = d.rebond.tous ? Math.round((d.rebond.seuls / d.rebond.tous) * 100) : 0;
    const spark = (v: number[]) => {
      if (!v.length || Math.max(...v) === 0) return '';
      const m = Math.max(...v), n = v.length;
      const pts = v.map((y, i) => `${(i / Math.max(n - 1, 1)) * 100},${30 - (y / m) * 26}`);
      return `<svg class="spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true"><path class="aire" d="M0,32 L${pts.join(' L')} L100,32 Z" /><path class="trait" d="M${pts.join(' L')}" /></svg>`;
    };
    const tuile = (l: string, v: string, sous: string, c: string, ic: string, compte?: [number, string], sp: number[] = []) =>
      `<div class="tuile" data-c="${c}"><span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24">${ICONES[ic]}</svg></span><span class="l">${l}</span>` +
      `<b${compte ? ` data-compte="${compte[0]}" data-fmt="${compte[1]}"` : ''}>${v}</b>${sous}${spark(sp)}</div>`;
    const serieDe = (k: keyof Jour) => d.serie.map((x) => Number(x[k]) || 0);
    const demandeurs = act('formulaire', 'visiteurs');
    $('tuiles').innerHTML = [
      tuile('Visiteurs', nb(vis), ecart(vis, Number(p.visiteurs), comparer), 'bleu', 'gens', [vis, 'nb'], serieDe('visiteurs')),
      tuile('Pages vues', nb(vues), ecart(vues, Number(p.vues), comparer), 'ciel', 'page', [vues, 'nb'], serieDe('vues')),
      vitrine
        ? tuile('Temps moyen par visiteur', vis && d.tempsTotal ? duree(d.tempsTotal / vis) : '—', '', 'marine', 'horloge', vis && d.tempsTotal ? [d.tempsTotal / vis, 'duree'] : undefined)
        : tuile('Pages par visiteur', vis ? (vues / vis).toLocaleString('fr-FR', { maximumFractionDigits: 1 }) : '—', '', 'marine', 'pile'),
      tuile('Repartis après 1 page', d.rebond.tous ? `${rebond} %` : '—', '', 'marine', 'sortie', d.rebond.tous ? [rebond, 'pct'] : undefined),
      ...(vitrine ? [
        tuile('Clics « Réserver »', nb(act('clic-contact')), ecart(act('clic-contact'), actAvant('clic-contact'), comparer), 'rouge', 'clic', [act('clic-contact'), 'nb'], serieDe('clics')),
        tuile('Demandes envoyées', nb(act('formulaire')), vis ? `<span class="ev">${(demandeurs / vis * 100).toLocaleString('fr-FR', { maximumFractionDigits: 1 })} % des visiteurs</span>` : '', 'rouge', 'envoi', [act('formulaire'), 'nb'], serieDe('demandes')),
      ] : []),
    ].join('');
    $('parties').innerHTML = 'Visiteurs sur la période : ' + ['vitrine', 'membre', 'perfs'].map((s) => {
      const x = d.totaux.find((y) => y.section === s);
      return `${SECTIONS[s]} <b>${nb(Number(x?.visiteurs || 0))}</b>`;
    }).join(' · ');

    const lab = etiquettes($('graphe'), d.serie, d.parMois);
    graphe($('graphe'), d.serie.map((x, i) => ({ v: x.visiteurs, x: lab[i].x, bulle: `<b>${esc(lab[i].nom)}</b>${nb(x.visiteurs)} visiteurs<br>${nb(x.vues)} pages vues` })),
      d.parMois ? undefined : moyenne7(d.serie.map((x) => x.visiteurs)));
    $('g-titre').textContent = d.parMois ? 'Visiteurs par mois' : 'Visiteurs par jour';
    $('g-legende').hidden = d.parMois;

    if (vitrine) {
      $('l-actions').innerHTML = ACTIONS.filter(([e]) => e !== 'formulaire-erreur' || act(e)).map(([e, nom]) =>
        `<li><span class="t">${nom}</span><span class="n">${nb(act(e))}${ecart(act(e), actAvant(e), comparer)}</span></li>`).join('');
      graphe($('graphe2'), d.serie.map((x, i) => ({ v: x.clics, x: lab[i].x, bulle: `<b>${esc(lab[i].nom)}</b>${nb(x.clics)} clics Réserver<br>${nb(x.demandes)} demandes envoyées<br>${nb(x.appels)} appels` })));
      $('g2-titre').textContent = d.parMois ? 'Clics sur Réserver par mois' : 'Clics sur Réserver par jour';
      const det = (e: string) => d.details.filter((x) => x.e === e);
      barres($('l-demandes'), det('formulaire'), (l) => String(l.d || 'Sans objet'), 'n', 'demandes');
      barres($('l-reserver'), d.pagesReserver, (l) => nomPage(String(l.page)), 'n', 'clics');
      barres($('l-sorties'), det('sortie'), (l) => String(l.d), 'n', 'clics');
      barres($('l-documents'), det('document'), (l) => String(l.d).replace(/\.[a-z]+$/i, '').replace(/[-_]/g, ' '), 'n', 'ouvertures');
      barres($('l-temps'), d.tempsPages, (l) => nomPage(String(l.page)), 'moyenne', '', duree);
    }

    const tot = d.heures.reduce((a, b) => a + b, 0) || 1;
    graphe($('g-heures'), d.heures.map((v, h) => ({ v, x: h % 6 === 0 ? `${h} h` : '', bulle: `<b>${h} h – ${h + 1} h</b>${Math.round((v / tot) * 100)} % des visiteurs` })));
    const ordre = [1, 2, 3, 4, 5, 6, 0];
    const totS = d.semaine.reduce((a, b) => a + b, 0) || 1;
    graphe($('g-semaine'), ordre.map((j) => ({ v: d.semaine[j], x: JOURS[j], bulle: `<b>${JOURS[j]}</b>${Math.round((d.semaine[j] / totS) * 100)} % des visiteurs` })));

    barres($('l-pages'), d.pages, (l) => nomPage(String(l.page)), 'vues', 'pages vues');
    barres($('l-entrees'), d.entrees, (l) => nomPage(String(l.page)), 'visiteurs', 'visiteurs');
    barres($('l-sources'), d.sources, (l) => String(l.source), 'visiteurs', 'visiteurs');
    donut($('d-appareils'), d.appareils.map((l) => ({ nom: APPAREILS[String(l.appareil)] || String(l.appareil), v: Number(l.visiteurs) || 0, c: COUL_APP[String(l.appareil)] || 'marine' })));
    barres($('l-villes'), d.villes, (l) => `${l.ville}${l.pays && l.pays !== 'FR' ? ` (${(() => { try { return PAYS.of(String(l.pays)); } catch { return l.pays; } })()})` : ''}`, 'visiteurs', 'visiteurs');
    compter($('tuiles'));
    const dir = $('direct');
    dir.hidden = false;
    dir.textContent = d.enDirect ? `${d.enDirect} en ce moment` : 'Personne en ce moment';
    dir.classList.toggle('on', d.enDirect > 0);
    if (d.depuis) $('pied-note').dataset.depuis = `Comptage depuis le ${new Date(d.depuis + 'T12:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}.`;
  }

  async function charger() {
    const r = await fetch(API, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ motDePasse: etat.mdp, jours: etat.jours, section: etat.section }) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : {};
    if (!r || !r.ok) {
      $('contenu').hidden = true; $('connexion').hidden = false;
      const e = $('erreur');
      e.hidden = !etat.mdp;
      e.textContent = !r ? 'Pas de réseau ?' : d.erreur || `Le serveur a répondu par une erreur (${r.status}). Réessayez dans un instant.`;
      return;
    }
    try { localStorage.setItem(CLE, etat.mdp); } catch { /* privé */ }
    $('connexion').hidden = true; $('contenu').hidden = false;
    afficher(d as Stats);
  }

  $('connexion').addEventListener('submit', (e) => { e.preventDefault(); etat.mdp = $<HTMLInputElement>('mdp').value.trim(); charger(); });
  for (const [id, cle] of [['f-section', 'section'], ['f-jours', 'jours']] as const) {
    $(id).addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-v]');
      if (!b) return;
      $(id).querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (cle === 'jours') etat.jours = Number(b.dataset.v); else etat.section = b.dataset.v!;
      charger();
    });
  }
  $('oublier').addEventListener('click', () => {
    try { localStorage.removeItem(CLE); } catch { /* privé */ }
    etat.mdp = ''; $<HTMLInputElement>('mdp').value = ''; $('erreur').hidden = true;
    $('contenu').hidden = true; $('connexion').hidden = false; $('direct').hidden = true;
  });
  if (etat.mdp) charger(); else $('connexion').hidden = false;
  setInterval(() => { if (etat.mdp && !$('contenu').hidden) charger(); }, 60_000);
</script>

