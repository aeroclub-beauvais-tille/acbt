---
import Base from '../../layouts/Base.astro';
import DocLien from '../../components/DocLien.astro';
import Metar from '../../components/Metar.astro';
import MembreTete from '../../components/MembreTete.astro';
import { getCollection } from 'astro:content';
import { RUBRIQUES_AVION, TYPES_AVION } from '../../content.config';
import { titreDoc, marquerHistorique, estOfficiel, type Doc } from '../../lib/documents';
import outils from '../../data/outils.json';
import membre from '../../data/membre.json';
import club from '../../data/club.json';
import { asset, url } from '../../lib/utils';
import { fichiersMembre } from '../../lib/membre';

const brut = await getCollection('documents');
const docs = marquerHistorique(brut.map((d) => ({ id: d.id, ...d.data } as Doc)))
  .sort((a, b) => a.ordre - b.ordre || titreDoc(a).localeCompare(titreDoc(b), 'fr'));
const vivants = (c: string) => docs.filter((d) => d.categorie === c && !d.archive);

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const docsAvion = docs.filter((d) => d.categorie === 'Documentation avion');
const rangType = (d: Doc) => { const i = TYPES_AVION.indexOf((d.type ?? '') as (typeof TYPES_AVION)[number]); return i < 0 ? 99 : i; };
const rangRub = (d: Doc) => RUBRIQUES_AVION.indexOf((d.rubrique ?? 'Autre') as (typeof RUBRIQUES_AVION)[number]);
const modele = (t: string) => t.replace(/-\d+.*$| Petit Prince| Paris-Nice/g, '').trim();

const flotte = avions.map((a) => {
  const im = a.data.immatriculation ?? a.data.nom;
  const mine = docsAvion.filter((d) => d.avions.includes(im));
  return {
    id: a.id,
    im,
    modele: modele(a.data.type),
    photo: a.data.photos[0],
    officiels: mine.filter((d) => estOfficiel(d) && !d.archive).sort((p, q) => rangType(p) - rangType(q)),
    techniques: mine.filter((d) => !estOfficiel(d) && !d.archive).sort((p, q) => rangRub(p) - rangRub(q)),
    historique: mine.filter((d) => d.archive).sort((p, q) => rangType(p) - rangType(q)),
  };
});

// Documents généraux / club à durée de validité (météo, règlement, statuts…)
const generaux = docs.filter((d) => d.avions.length === 0 && estOfficiel(d) && !d.archive);
const historiqueGen = docs.filter((d) => d.avions.length === 0 && estOfficiel(d) && d.archive);
const meteo = generaux.filter((d) => d.type === 'Bulletin météo');
const autresGen = generaux.filter((d) => d.type !== 'Bulletin météo');

// Mémos et formulaires pour « Préparer son vol » (hors documents officiels à validité, montrés ailleurs)
const memos = ['Sécurité', 'Préparation des vols', 'Météo', 'Formulaires']
  .map((c) => ({ c, docs: vivants(c).filter((d) => !estOfficiel(d)) }))
  .filter((x) => x.docs.length);
const docsClub = vivants('Vie du club').filter((d) => !estOfficiel(d));
const host = (l: string) => new URL(l).hostname.replace(/^www\./, '');

const hors = await fichiersMembre();
const mo = Math.round(hors.taille / 1e6);
const connexion = url('/membre/connexion/');

const onglets = [
  { id: 'accueil', nom: 'Accueil', svg: 'M3 11l9-8 9 8M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10' },
  { id: 'avions', nom: 'Avions', svg: 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z' },
  { id: 'club', nom: 'Club', svg: 'M3 21h18M5 21V7l8-4v18M19 21V11l-6-3M9 9v.01M9 12v.01M9 15v.01M9 18v.01' },
  { id: 'preparer', nom: 'Préparer', svg: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 0v4m0 12v4m10-10h-4M6 12H2m14.9-4.9l-2.8 2.8M9.9 14.1l-2.8 2.8m0-9.8l2.8 2.8m4.2 4.2l2.8 2.8' },
  { id: 'formation', nom: 'Formation', svg: 'M22 10L12 5 2 10l10 5 10-5zM6 12v5c0 1 3 3 6 3s6-2 6-3v-5M22 10v6' },
];
---
<Base univers="membres" title="Espace membre" description="Espace réservé aux membres de l'aéroclub de Beauvais-Tillé : météo, documents des avions et du club, préparation des vols." noindex>
  <Fragment slot="head">
    <MembreTete />
    <script is:inline define:vars={{ connexion }}>
      try { if (!localStorage.getItem('acbt-membre')) location.replace(connexion + '?retour=' + encodeURIComponent(location.pathname + location.hash)); } catch (e) {}
    </script>
  </Fragment>
  <div slot="entete" class="icones">
    <button type="button" class="icone" id="installer" title="Installer l'appli sur ce téléphone" aria-label="Installer l'appli sur ce téléphone" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M12 7v7" /><path d="M9 11l3 3 3-3" /><path d="M10.5 18.5h3" /></svg>
    </button>
    <button type="button" class="icone" id="deconnexion" title="Se déconnecter" aria-label="Se déconnecter">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" /></svg>
    </button>
  </div>

  <header class="tete">
    <div class="container tete-in">
      <div><span class="label">Espace membre</span><h1>ACBT Pilotes</h1></div>
      <a class="btn btn-primary" href={club.aerogest} rel="noopener">Réserver sur Aerogest</a>
    </div>
  </header>

  <nav id="onglets" class="onglets" aria-label="Sections de l'espace membre">
    <div class="container onglets-in" role="tablist">
      {onglets.map((o) => (
        <button type="button" role="tab" data-onglet={o.id} aria-selected={o.id === 'accueil'} aria-controls={o.id}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.svg} /></svg>
          <span>{o.nom}</span>
        </button>
      ))}
    </div>
  </nav>

  <div class="recherchebar">
    <div class="container">
      <label class="cherche"><span class="sr">Rechercher un document</span>
        <input type="search" id="q" placeholder="Rechercher un document…" autocomplete="off" />
      </label>
    </div>
  </div>
  <p class="container aucun" id="aucun" hidden>Aucun document ne correspond à votre recherche.</p>

  <!-- ACCUEIL -->
  <section class="section panneau" id="accueil" role="tabpanel">
    <div class="container">
      <div class="metar-bloc" data-bloc>
        <h2 class="titre-bloc">Météo du terrain — Beauvais LFOB</h2>
        <div class="carte-metar"><Metar /></div>
      </div>

      <div class="alerte-docs" id="alerte-docs" data-n="0">
        <div data-pleine hidden>
          <h2 class="titre-bloc"><span class="pt-alerte" aria-hidden="true">!</span>Documents à renouveler</h2>
          <ul class="liste-alerte" data-liste></ul>
          <p class="note">Rendez-vous dans l'onglet <button type="button" class="lien-onglet" data-vers="avions">Avions</button> ou <button type="button" class="lien-onglet" data-vers="club">Club</button> pour le document concerné.</p>
        </div>
        <p class="ok" data-vide>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
          Tous les documents à échéance sont à jour.
        </p>
      </div>

      {meteo.length > 0 && (
        <div class="bloc-accueil" data-bloc>
          <h2 class="titre-bloc">Dernier bulletin météo</h2>
          <div class="docs">{meteo.map((d) => <DocLien doc={d} vers="club" />)}</div>
        </div>
      )}

      <div class="appli" data-bloc>
        <div class="hors-ligne" id="hors-ligne" data-fichiers={JSON.stringify(hors.liste)}>
          <span class="pastille" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" /></svg>
          </span>
          <div>
            <strong>Documents hors ligne</strong>
            <span data-etat>Chaque document ouvert reste disponible sans réseau.</span>
            <progress hidden></progress>
          </div>
          <button type="button" class="btn btn-outline"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 21h14" /></svg>Tout télécharger ({mo} Mo)</button>
        </div>
        <p class="aide-ios" id="aide-ios" hidden>Sur iPhone : touchez le bouton <b>Partager</b> (le carré avec une flèche) en bas de Safari, puis <b>Sur l'écran d'accueil</b>.</p>
      </div>
    </div>
  </section>

  <!-- AVIONS -->
  <section class="section panneau" id="avions" role="tabpanel" hidden>
    <div class="container">
      <div class="section-head"><div><span class="label">Nos avions</span><h2>Documents par avion</h2></div></div>
      <div class="selecteur" id="selecteur" role="group" aria-label="Choisir un avion">
        <button type="button" data-avion="" aria-pressed="true">Tous</button>
        {flotte.map((x) => (
          <button type="button" data-avion={x.im} aria-pressed="false">{x.photo && <img src={asset(x.photo)} alt="" loading="lazy" />}<span><b>{x.im}</b><small>{x.modele}</small></span></button>
        ))}
      </div>
      <div class="fiches" id="fiches">
        {flotte.map((x) => (
          <article class="fiche" id={`doc-${x.id}`} data-ims={x.im} data-bloc>
            <header>
              <div class="photos">{x.photo && <img src={asset(x.photo)} alt="" loading="lazy" />}</div>
              <div><h3>{x.im}</h3><div class="chips"><span>{x.modele}</span></div></div>
            </header>

            <h5 class="sep">Documents officiels</h5>
            {x.officiels.length > 0
              ? <div class="liste">{x.officiels.map((d) => <DocLien doc={d} vers="avions" />)}</div>
              : <p class="rien">Aucun document officiel pour le moment.</p>}

            {x.techniques.length > 0 && <h5 class="sep">Manuels et check-lists</h5>}
            <div class="liste">{x.techniques.map((d) => <DocLien doc={d} court={titreDoc(d).replace(` ${x.im}`, '')} />)}</div>

            {x.historique.length > 0 && (
              <details class="histo">
                <summary>Historique ({x.historique.length})</summary>
                <div class="liste">{x.historique.map((d) => <DocLien doc={d} vers="avions" />)}</div>
              </details>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CLUB -->
  <section class="section panneau" id="club" role="tabpanel" hidden>
    <div class="container">
      <div class="section-head"><div><span class="label">Vie du club</span><h2>Documents du club</h2></div></div>
      {autresGen.length > 0 && <div class="docs" data-bloc>{autresGen.map((d) => <DocLien doc={d} vers="club" />)}</div>}
      {meteo.length > 0 && (
        <div data-bloc>
          <h3 class="sous-titre">Bulletins météo</h3>
          <div class="docs">{meteo.map((d) => <DocLien doc={d} vers="club" />)}</div>
        </div>
      )}
      {docsClub.length > 0 && (
        <div data-bloc>
          <h3 class="sous-titre">Documentation de l'association</h3>
          <div class="docs">{docsClub.map((d) => <DocLien doc={d} />)}</div>
        </div>
      )}
      <div class="liens" data-bloc>
        <a class="btn btn-outline" href={club.aerogest} rel="noopener">Aerogest</a>
        {membre.liens_club.filter((l) => l.lien).map((l) => <a class="btn btn-outline" href={l.lien} rel="noopener">{l.libelle}</a>)}
      </div>
      {historiqueGen.length > 0 && (
        <details class="histo" data-bloc>
          <summary>Historique des documents du club ({historiqueGen.length})</summary>
          <div class="docs">{historiqueGen.map((d) => <DocLien doc={d} vers="club" />)}</div>
        </details>
      )}
    </div>
  </section>

  <!-- PRÉPARER SON VOL -->
  <section class="section panneau" id="preparer" role="tabpanel" hidden>
    <div class="container">
      <div class="section-head"><div><span class="label">Préparer son vol</span><h2>Les outils du pilote</h2></div></div>
      <div class="cats-outils">
      {outils.categories.map((c) => (
        <div class="bloc" data-bloc>
          <h3>{c.titre}</h3>
          <div class="grid grille-outils">
            {c.outils.map((o) => (
              <a class="card outil" href={o.lien} target="_blank" rel="noopener" data-q={`${o.nom} ${o.description}`.toLowerCase()}><div class="card-body">
                <div class="outil-tete">
                  <span class:list={['logo-site', { perso: (o as { logo?: string }).logo }]} data-init={o.nom.replace(/[^A-Za-zÀ-ÿ0-9]/g, '').slice(0, 2).toUpperCase()}>
                    <img src={(o as { logo?: string }).logo ? asset((o as { logo?: string }).logo!) : `https://www.google.com/s2/favicons?domain=${host(o.lien)}&sz=128`} alt="" width="40" height="40" loading="lazy" onerror="this.remove()" />
                  </span>
                  <h4>{o.nom} ↗</h4>
                </div>
                <p>{o.description}</p>
              </div></a>
            ))}
          </div>
        </div>
      ))}
      </div>
      {vivants('Documentation pilote').length > 0 && (
        <div class="bloc" data-bloc>
          <h3 class="sous-titre">Terrain, espace aérien et réglementation</h3>
          <div class="docs docs-2">{vivants('Documentation pilote').map((d) => <DocLien doc={d} />)}</div>
        </div>
      )}
      {memos.length > 0 && (
        <div class="bloc" data-bloc>
          <h3 class="sous-titre">Mémos et formulaires</h3>
          <div class="cats-outils cats-docs">
            {memos.map((x) => (
              <div data-bloc>
                <h4 class="cat-doc">{x.c}</h4>
                <div class="pile">{x.docs.map((d) => <DocLien doc={d} />)}</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- FORMATION -->
  <section class="section panneau" id="formation" role="tabpanel" hidden>
    <div class="container">
      <div class="section-head"><div><span class="label">Formation</span><h2>Livrets, progression et examens</h2></div></div>
      <div class="form-blocs">
        {membre.parcours.map((e) => {
          const liste = e.categorie_docs ? vivants(e.categorie_docs) : [];
          const liens = e.liens.filter((l) => l.lien);
          return (
            <div class="form-bloc" data-bloc>
              <h3>{e.titre}</h3>
              {liste.length > 0 && <div class="docs">{liste.map((d) => <DocLien doc={d} />)}</div>}
              {liens.length > 0 && <div class="liens">{liens.map((l) => <a class="btn btn-outline" href={l.lien} target="_blank" rel="noopener">{l.libelle} ↗</a>)}</div>}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<script>
  import { enregistrer, horsLigne, boutonInstaller, seDeconnecter, badges, onglets } from '../../scripts/membre-app';
  enregistrer();
  const montrer = onglets();
  badges();
  horsLigne(document.getElementById('hors-ligne'));
  boutonInstaller(document.getElementById('installer') as HTMLButtonElement, document.getElementById('aide-ios'));
  document.getElementById('deconnexion')?.addEventListener('click', () => {
    if (confirm('Se déconnecter de l\'espace membre sur cet appareil ? Les documents gardés hors ligne seront effacés.')) seDeconnecter();
  });
  document.querySelectorAll<HTMLElement>('.lien-onglet[data-vers]').forEach((b) => b.addEventListener('click', () => montrer?.(b.dataset.vers!)));

  // Sélecteur d'avion : n'affiche que les documents de l'avion choisi, et s'en souvient sur cet appareil
  const fichesEl = document.getElementById('fiches');
  const boutonsAvion = [...document.querySelectorAll<HTMLButtonElement>('#selecteur [data-avion]')];
  const choisirAvion = (im: string) => {
    if (im && !boutonsAvion.some((b) => b.dataset.avion === im)) im = '';
    boutonsAvion.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.avion === im)));
    fichesEl?.classList.toggle('un', !!im);
    fichesEl?.querySelectorAll<HTMLElement>('[data-ims]').forEach((el) => {
      el.classList.toggle('autre-avion', !!im && el.dataset.ims !== im);
    });
    try { im ? localStorage.setItem('acbt-avion', im) : localStorage.removeItem('acbt-avion'); } catch { /* navigation privée */ }
  };
  boutonsAvion.forEach((b) => b.addEventListener('click', () => choisirAvion(b.dataset.avion || '')));
  try { const avant = localStorage.getItem('acbt-avion'); if (avant) choisirAvion(avant); } catch { /* rien */ }

  // Recherche : balaie tous les onglets à la fois (ajoute la classe « recherche » au corps)
  const q = document.getElementById('q') as HTMLInputElement | null;
  const aucun = document.getElementById('aucun');
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  q?.addEventListener('input', () => {
    const v = norm(q.value.trim());
    document.body.classList.toggle('recherche', !!v);
    document.querySelectorAll<HTMLElement>('[data-q]').forEach((el) => { el.hidden = !!v && !norm(el.dataset.q || '').includes(v); });
    [...document.querySelectorAll<HTMLElement>('[data-bloc]')].reverse().forEach((b) => {
      b.hidden = !!v && !b.querySelector('[data-q]:not([hidden])');
    });
    if (aucun) aucun.hidden = !v || !!document.querySelector('[data-q]:not([hidden])');
  });
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  [hidden] { display: none !important; }

  /* En-tête opérationnel (sans photo) */
  .tete { background: var(--ink); color: #fff; }
  .tete-in { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; flex-wrap: wrap; }
  .tete .label { color: var(--accent); }
  .tete h1 { margin: 2px 0 0; font-size: clamp(1.5rem, 4vw, 2rem); }
  .icones { display: flex; gap: 8px; }
  .icone { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; padding: 0; transition: border-color .15s, color .15s; }
  .icone:hover, .icone:focus-visible { border-color: var(--accent); color: var(--accent); }
  .icone[hidden] { display: none; }

  /* Barre d'onglets, collante sous l'en-tête du site */
  .onglets { position: sticky; top: 76px; z-index: 20; background: rgba(246,242,234,.96); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); transition: top .5s cubic-bezier(.2,.7,.2,1); }
  :global(body:has(.site-header.cache)) .onglets { top: 0; }
  .onglets-in { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 6px 16px; }
  .onglets-in::-webkit-scrollbar { display: none; }
  .onglets button { display: inline-flex; align-items: center; gap: 8px; flex: none; padding: 9px 16px; border: 0; background: none; color: var(--muted); font: inherit; font-size: .92rem; font-weight: 600; border-radius: 999px; cursor: pointer; white-space: nowrap; transition: background .15s, color .15s; }
  .onglets button:hover { color: var(--ink); }
  .onglets button.actif { background: var(--accent); color: #fff; }
  .onglets svg { flex: none; }
  @media (max-width: 560px) { .onglets button span { font-size: .8rem; } .onglets button { padding: 8px 12px; } }

  .recherchebar { border-bottom: 1px solid var(--line); background: #fff; }
  .recherchebar .container { padding-top: 10px; padding-bottom: 10px; }
  .cherche { display: block; width: 100%; }
  .cherche input { width: 100%; max-width: 520px; display: block; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font: inherit; font-size: .92rem; }
  .cherche input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  @media (max-width: 860px) { .cherche input { max-width: none; } }
  .aucun { padding-top: 32px; color: var(--muted); }

  /* Panneaux : masqués sauf l'actif ; en recherche, tous visibles */
  :global(body.recherche) .panneau[hidden] { display: block !important; }
  :global(body.recherche) .onglets { display: none; }

  .titre-bloc { font-size: 1.15rem; display: flex; align-items: center; gap: 10px; margin: 0 0 14px; }
  .sous-titre { font-size: 1.2rem; margin: 28px 0 14px; }
  .bloc-accueil { margin-top: 24px; }

  /* METAR : présenté comme un outil opérationnel, bien visible */
  .metar-bloc { margin-bottom: 8px; }
  .carte-metar { padding: 16px 18px; border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 12px; background: #fff; }

  /* Bandeau d'alerte documents (les lignes sont créées en JS : styles en :global) */
  .alerte-docs { margin-top: 24px; }
  .pt-alerte { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #b42318; color: #fff; display: grid; place-items: center; font-weight: 700; }
  .liste-alerte { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  :global(.liste-alerte .al) { display: flex; gap: 10px; align-items: center; padding: 10px 14px; border-radius: 12px; border: 1px solid; font-size: .92rem; }
  :global(.liste-alerte .al .pt) { flex: none; width: 9px; height: 9px; border-radius: 50%; background: currentColor; }
