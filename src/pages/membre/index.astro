---
import MembreApp from '../../layouts/MembreApp.astro';
import DocLien from '../../components/DocLien.astro';
import Metar from '../../components/MetarMembre.astro';
import Taf from '../../components/Taf.astro';
import Logo from '../../components/Logo.astro';
import { getCollection } from 'astro:content';
import { RUBRIQUES_AVION, TYPES_AVION } from '../../content.config';
import AdminDocs from '../../components/AdminDocs.astro';
import { titreDoc, marquerHistorique, estOfficiel, type Doc } from '../../lib/documents';
import outils from '../../data/outils.json';
import club from '../../data/club.json';
import { asset, url, cleFormulaire } from '../../lib/utils';

const brut = await getCollection('documents');
const docs = marquerHistorique(brut.map((d) => ({ id: d.id, ...d.data } as Doc)))
  .sort((a, b) => a.ordre - b.ordre || titreDoc(a).localeCompare(titreDoc(b), 'fr'));
const vivants = (c: string) => docs.filter((d) => d.categorie === c && !d.archive);

const avions = (await getCollection('avions', (a) => a.data.actif)).sort((a, b) => a.data.ordre - b.data.ordre);
const docsAvion = docs.filter((d) => d.categorie === 'Documentation avion');
const rangType = (d: Doc) => { const i = TYPES_AVION.indexOf((d.type ?? '') as (typeof TYPES_AVION)[number]); return i < 0 ? 99 : i; };
const rangRub = (d: Doc) => RUBRIQUES_AVION.indexOf((d.rubrique ?? 'Autre') as (typeof RUBRIQUES_AVION)[number]);
const modele = (t: string) => t.replace(/-\d+.*$| Petit Prince| Paris-Nice/g, '').trim();

// Documents à emporter lors d'un vol (« le minimum exigé »), dans cet ordre.
const REQUIS: { nom: string; place: string; types?: string[]; rubrique?: string; pesee?: boolean }[] = [
  { place: 'immat', nom: 'Certificat d’immatriculation', types: ["Certificat d'immatriculation"] },
  { place: 'cdn', nom: 'Certificat de navigabilité', types: ['Certificat de navigabilité (CDN)'] },
  { place: 'cen', nom: 'Certificat d’examen de navigabilité', types: ["Certificat d'examen de navigabilité (CEN)"] },
  { place: 'lsa', nom: 'Licence station radio (LSA)', types: ['Licence station radio', 'Autorisation radio'] },
  { place: 'acoustique', nom: 'Certificat de limitation de nuisance', types: ['Certificat acoustique'] },
  { place: 'assurance', nom: 'Attestation d’assurance RC', types: ['Assurance'] },
  { place: 'pesee', nom: 'Fiche de pesée et centrage', pesee: true },
  { place: 'mdv', nom: 'Manuel de vol', rubrique: 'Manuel de vol' },
];
// Pièces à avoir sur soi (texte voulu par le club, 25/11)
const PIECES = [['Pilote', 'Licence, Classe 2, CNI, CB'], ['Passager(s)', 'CNI']];
const estPesee = (d: Doc) => d.type === 'Fiche de pesée et centrage' || /pes[ée]e/i.test(d.titre ?? '');

const flotte = avions.map((a) => {
  const im = a.data.immatriculation ?? a.data.nom;
  const mine = docsAvion.filter((d) => d.avions.includes(im));
  const vivants = mine.filter((d) => !d.archive);
  const pris = new Set<string>();
  const requis = REQUIS.map((r) => {
    const doc = vivants.find((d) => !pris.has(d.id) && (r.pesee ? estPesee(d) : r.types ? r.types.includes(d.type ?? '') : !estOfficiel(d) && d.rubrique === r.rubrique));
    if (doc) pris.add(doc.id);
    return { nom: r.nom, place: r.place, doc };
  });
  // Autres documents officiels de l'avion (type non listé ci-dessus) : à la suite, avec leur badge
  const autres = vivants.filter((d) => estOfficiel(d) && !pris.has(d.id)).sort((p, q) => rangType(p) - rangType(q));
  return {
    id: a.id, im, modele: modele(a.data.type), photo: a.data.photos[0],
    requis, autres,
    techniques: vivants.filter((d) => !estOfficiel(d) && !pris.has(d.id)).sort((p, q) => rangRub(p) - rangRub(q)),
    historique: mine.filter((d) => d.archive).sort((p, q) => rangType(p) - rangType(q)),
  };
});

// Bulletins météo (MAA) — gérés à part (horaires précis, pas « à renouveler »)
const meteo = docs.filter((d) => d.type === 'Bulletin météo' && !d.archive).sort((a, b) => (a.debut?.getTime() ?? 0) - (b.debut?.getTime() ?? 0));
const memos = ['Sécurité', 'Préparation des vols', 'Météo', 'Formulaires']
  .map((c) => ({ c, docs: vivants(c).filter((d) => !estOfficiel(d)) })).filter((x) => x.docs.length);
// Données pour le mode admin (mêmes informations que les fiches, déjà publiques)
const jour = (d?: Date) => d ? d.toISOString().slice(0, 10) : undefined;
const adminDonnees = {
  version: process.env.GITHUB_SHA || '',
  types: [...TYPES_AVION], rubriques: [...RUBRIQUES_AVION],
  docs: docs.map((d) => ({ id: d.id, titre: d.titre, type: d.type, rubrique: d.rubrique, avions: d.avions, debut: jour(d.debut), fin: jour(d.fin), fichier: d.fichier, lien: d.lien, ordre: d.ordre, remplace: d.remplace, archive: d.archive })),
};
const host = (l: string) => new URL(l).hostname.replace(/^www\./, '');
const connexion = url('/membre/connexion/');
// Modèle affiché dans l'onglet Flotte. Les avions qui sont dans Aerogest mais pas encore dans le contenu du site sont listés ici.
const modeles = { 'F-BTBJ': 'DR315', ...Object.fromEntries(flotte.map((a) => [a.im, a.modele.replace(/^Robin |^Jodel /, '')])) };

const onglets = [
  { id: 'accueil', nom: 'Météo', svg: 'M17.5 19a4.5 4.5 0 1 0-.9-8.9A6 6 0 1 0 6 19h11.5z' },
  { id: 'notam', nom: 'NOTAM', svg: 'M12 3 2 20h20L12 3zM12 10v4M12 17h.01' },
  { id: 'flotte', nom: 'Flotte', svg: 'M12 14l4.5-4.5M3.5 18a9.5 9.5 0 1 1 17 0M12 14h.01' },
  { id: 'avions', nom: 'Avions', svg: 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z' },
  { id: 'preparer', nom: 'Préparer', svg: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4v12m10-6H2' },
  // Réservé aux responsables : visible seulement sur un appareil où le mot de passe admin a été saisi
  { id: 'admin', nom: 'Admin', svg: 'M12 2l8 3v6c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5l8-3zM9 12l2 2 4-4', admin: true },
];
// Outils de l'onglet Admin
const outilsAdmin = [
  { lien: '/membre/messages/', nom: 'Messages du club', desc: 'Écrire un message envoyé à tous les membres', svg: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z' },
  { lien: '/membre/alertes-meteo/', nom: 'Alertes météo', desc: 'MAA et LVP reçus par mail, arrêter une alerte', svg: 'M12 3 2 20h20L12 3zM12 10v4M12 17h.01' },
  { lien: '/membre/signalements/', nom: 'Signalements techniques', desc: 'Problèmes signalés sur les avions', svg: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z' },
  { lien: '/membre/facebook/', nom: 'Actus Facebook', desc: 'Lien actif, dernière copie, publications récupérées', svg: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
  { lien: '/statistiques/', nom: 'Statistiques du site', desc: 'Fréquentation de acbt60.fr et de l\'appli', svg: 'M4 20V10M10 20V4M16 20v-7M22 20H2' },
  { lien: '/membre/tarifs/', nom: 'Tarifs', desc: 'Programmer un changement de prix avec sa date d\'effet', svg: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6' },
  { lien: '/membre/admin/', nom: 'Documents des avions', desc: 'Déposer, remplacer ou retirer un document', svg: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M12 18v-6M9 15h6' },
];
---
<MembreApp title="Espace membres">
  <script slot="head" is:inline define:vars={{ connexion }}>
    try {
      var ret = '?retour=' + encodeURIComponent(location.pathname + location.hash);
      if (localStorage.getItem('acbt-admin-alertes') || localStorage.getItem('acbt-admin-jeton')) document.documentElement.classList.add('est-admin');
      if (!localStorage.getItem('acbt-membre')) location.replace(connexion + ret);
      // Sur téléphone, ouvert dans le navigateur (et pas dans l'appli installée) : on propose d'abord d'installer l'appli
      else if (/android|iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
        var appli = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        if (!appli && !sessionStorage.getItem('acbt-navigateur')) location.replace(connexion + ret);
      }
    } catch (e) {}
  </script>

  <header class="topbar">
    <a class="marque" href={url('/membre/')} aria-label="Accueil espace membres"><Logo class="logo" /><span>Espace membres</span></a>
    <div class="actions">
      <button type="button" class="ic" id="btn-theme" aria-label="Changer de thème"></button>
      <button type="button" class="ic" id="btn-recherche" aria-label="Rechercher un document">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" /></svg>
      </button>
      <button type="button" class="ic cloche" id="btn-notif" aria-label="Recevoir les messages du club en notification" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /><path class="barre" d="M3 3l18 18" /></svg>
      </button>
      <button type="button" class="ic" id="installer" aria-label="Installer l'appli" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M12 7v7M9 11l3 3 3-3M10.5 18.5h3" /></svg>
      </button>
      <button type="button" class="ic" id="deconnexion" aria-label="Se déconnecter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
      </button>
    </div>
  </header>

  <div class="searchwrap" id="searchwrap" hidden>
    <input type="search" id="q" placeholder="Rechercher un document…" autocomplete="off" />
    <button type="button" id="fermer-recherche" aria-label="Fermer la recherche">✕</button>
  </div>
  <p class="aucun" id="aucun" hidden>Aucun document ne correspond.</p>

  <main class="content">
    <!-- ACCUEIL -->
    <section class="panneau" id="accueil">
      <div class="lvp-banniere" id="lvp" hidden>
        <span class="lvp-logo" aria-hidden="true">LVP</span>
        <span class="maa-txt">
          <strong>Procédures par faible visibilité</strong>
          <span class="maa-num" id="lvp-depuis">LVP activées</span>
        </span>
      </div>
      <div id="maa-zone" hidden>
        {meteo.map((m) => (
          <a class="maa-banniere" data-maa data-numero={m.numero} data-debut={m.debut?.toISOString()} data-fin={m.fin?.toISOString()} href={m.fichier ? asset(m.fichier) : (m.lien || undefined)} target="_blank" rel="noopener" hidden>
            <span class="maa-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L1 21h22L12 2z" /><path d="M12 9v5M12 17.5v.01" /></svg></span>
            <span class="maa-txt">
              <strong data-maa-titre>Avertissement météo en cours</strong>
              <span class="maa-num">MAA n°{m.numero ?? '—'}</span>
            </span>
            <span class="maa-pdf">PDF ↗</span>
          </a>
        ))}
      </div>
      <div class="snow-alerte" id="snow-alerte" hidden>
        <span class="maa-txt"><strong>SNOWTAM en vigueur</strong><span class="maa-num">état des pistes publié · voir l'onglet NOTAM</span></span>
      </div>
      <p class="maa-rien" id="maa-rien" hidden>
        <i class="maa-rien-pt" aria-hidden="true"></i>
        <span><b id="maa-rien-t">Aucune alerte météo</b> <span class="maa-rien-s" id="maa-rien-s">ni MAA ni SNOWTAM, en cours ou à venir</span></span>
      </p>
      <template id="maa-modele">
        <a class="maa-banniere" data-maa target="_blank" rel="noopener" hidden>
          <span class="maa-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L1 21h22L12 2z" /><path d="M12 9v5M12 17.5v.01" /></svg></span>
          <span class="maa-txt">
            <strong data-maa-titre>Avertissement météo en cours</strong>
            <span class="maa-num">MAA</span>
          </span>
          <span class="maa-pdf">PDF ↗</span>
        </a>
      </template>

      <!-- Météo sur une seule page (choix du club, 25/11) : frise du soleil sur toute la largeur, comme la TV ;
           à gauche vent et pistes puis vents en altitude, à droite METAR, TAF et METAR voisins (une colonne sur téléphone). -->
      <div class="soleil" id="soleil" aria-label="Soleil à LFOB, heures locales">
          <div class="sol-frise" aria-hidden="true">
            <span class="a" data-soleil-a></span><span class="j" data-soleil-j></span>
            <span class="now" data-soleil-now><em data-soleil-h></em></span>
          </div>
          <div class="sol-graduations" aria-hidden="true"><span>00h</span><span>06h</span><span>12h</span><span>18h</span><span>24h</span></div>
          <div class="sol-cases">
            <div class="aero"><small>Jour aéro.</small><b><span data-soleil="jourAero">--:--</span></b></div>
            <div><small>Lever</small><b><span data-soleil="lever">--:--</span></b></div>
            <div><small>Coucher</small><b><span data-soleil="coucher">--:--</span></b></div>
            <div class="aero"><small>Nuit aéro.</small><b><span data-soleil="nuitAero">--:--</span></b></div>
          </div>
      </div>

      <div class="vue-meteo vue-terrain" id="vue-terrain">
        <div class="col-g">
        <div class="bloc-vent">
          <h2 class="bt bt-suite">Vent et pistes <span class="bt-nb" id="vent-info"></span></h2>
          <div class="carte-vent" id="vent" data-api={url('/membre/api/vent')}><p class="vide">Chargement du vent…</p></div>
        </div>

        </div>
        <div class="col-d">
        <div class="carte-metar"><Metar /></div>

        <div class="carte-metar carte-taf"><Taf /></div>

        <a class="carte-aeroweb" href="https://aeroweb.meteo.fr/#/login" target="_blank" rel="noopener">
          <span><b>TEMSI et WINTEM sur AEROWEB</b><small>Nouvelle version. Nouveau compte requis.</small></span>
          <span class="fl" aria-hidden="true">↗</span>
        </a>

        <div class="bloc-voisins">
          <h2 class="bt bt-suite">METAR voisins <span class="bt-nb" id="voisins-h"></span></h2>
          <div class="carte-voisins" id="voisins"><p class="vide">Chargement…</p></div>
        </div>
        <div class="bloc-alt">
          <h2 class="bt bt-suite">Vents en altitude LFOB <span class="bt-nb">kt · modèle AROME</span></h2>
          <div class="carte-alt" id="altitude" data-api={url('/membre/api/aero')}><p class="vide">Chargement…</p></div>
        </div>
        </div>
      </div>

      <p class="aide-ios" id="aide-ios" hidden>Sur iPhone : touchez <b>Partager</b> en bas de Safari, puis <b>Sur l'écran d'accueil</b>.</p>
    </section>

    <!-- NOTAM -->
    <section class="panneau" id="notam" hidden>
      <h1 class="titre">NOTAM LFOB <span class="bt-nb" id="notam-nb"></span></h1>
      <div class="carte-notam nl" id="notam-liste" data-api={url('/membre/api/notam')}><p class="vide">Chargement des NOTAM…</p></div>
      <p class="fl-info" id="notam-info"></p>
    </section>

    <!-- FLOTTE -->
    <section class="panneau" id="flotte" hidden>
      <h1 class="titre">Flotte</h1>
      <div class="fl-liste" id="flotte-liste" data-api={url('/membre/api/flotte')} data-modeles={JSON.stringify(modeles)}></div>
      <p class="fl-info" id="flotte-info"></p>
    </section>

    <!-- AVIONS -->
    <section class="panneau" id="avions" hidden>
      <h1 class="titre">Documents par avion</h1>
      <div class="adm-barre" id="adm-barre">
        <span class="adm-pill">Mode admin</span>
        <span class="adm-barre-txt"></span>
        <button type="button" id="adm-quitter">Quitter</button>
      </div>
      <p class="adm-attente" id="adm-attente" hidden>Publication en cours : l'appli sera à jour d'ici 2 à 3 minutes.</p>
      <div class="alerte-docs" id="alerte-docs">
        <div data-pleine hidden>
          <h2 class="bt bt-rouge"><span class="pt-alerte" aria-hidden="true">!</span>Documents à renouveler</h2>
          <ul class="liste-alerte" data-liste></ul>
        </div>
      </div>
      <div class="av-voile" aria-hidden="true"></div>
      <div class="av-select" id="selecteur">
        <button type="button" class="av-trig" id="av-trig" data-vide="oui" aria-haspopup="listbox" aria-expanded="false" aria-label="Choisir un avion">
          <span class="av-trig-dot av-dot" aria-hidden="true"></span>
          <svg class="av-trig-plane" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" /></svg>
          <span class="av-trig-main"><span class="av-trig-txt">Choisir un avion</span><span class="av-trig-sub"></span></span>
          <span class="av-trig-st av-st" aria-hidden="true"></span>
          <svg class="av-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div class="av-menu" id="av-menu" role="listbox" aria-label="Avions du club" hidden>
          {flotte.map((x) => (
            <button type="button" class="av-opt" data-avion={x.im} role="option" aria-selected="false">
              <span class="av-dot" aria-hidden="true"></span>
              <span class="av-id"><b>{x.im}</b><small>{x.modele}</small></span>
              <span class="av-st" aria-hidden="true"></span>
            </button>
          ))}
        </div>
      </div>
      <!-- Flotte toujours visible (choix du club, 25/11) : liste à gauche sur iPad en paysage, pastilles en haut ailleurs -->
      <div class="av-md">
      <div class="av-liste" id="av-liste" role="listbox" aria-label="Avions du club">
        {flotte.map((x) => (
          <button type="button" class="av-item" data-avion={x.im} role="option" aria-selected="false">
            <span class="av-dot" aria-hidden="true"></span>
            <span class="av-id"><b>{x.im}</b><small>{x.modele}</small></span>
            <span class="av-st" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="fiches" id="fiches">
        {flotte.map((x) => (
          <article class="fiche cache" data-ims={x.im}>
            <header>
              <div><h3>{x.im}</h3><span class="av-mod">{x.modele}</span></div>
            </header>
            <div class="fiche-act">
            <button type="button" class="signaler" data-signaler data-avion={x.im}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4M12 17h.01" /></svg>
              Signaler un problème
            </button>
            <a class="sig-liste" href={url('/membre/signalements/') + '?avion=' + encodeURIComponent(x.im)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" /></svg>Signalements en cours</a>
            </div>
            <button type="button" class="adm-depot" data-depot={x.im} hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5" /><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
              <span><b>Ajouter un document</b><small>Glissez un fichier ici ou touchez pour choisir</small></span>
            </button>
            <div class="fiche-cols"><div>
            <h5 class="sep sep-col">Documents nécessaires au vol</h5>
            <div class="liste compacte">
              {x.requis.map((r) => r.doc
                ? <DocLien doc={r.doc} court={r.nom} badge vers="avions" ligne place={r.place} />
                : <DocLien doc={{ titre: r.nom }} manquant ligne place={r.place} />)}
              {x.autres.map((d) => <DocLien doc={d} vers="avions" ligne />)}
            </div>
            <div class="pilote">{PIECES.map(([qui, quoi]) => <p class="piece"><b>{qui} :</b> {quoi}</p>)}</div>
            </div><div>
            <h5 class="sep" data-manuels-t hidden={x.techniques.length === 0}>Manuels du matériel</h5>
            <div class="liste" data-manuels>{x.techniques.map((d) => <DocLien doc={d} court={titreDoc(d).replace(` ${x.im}`, '')} />)}</div>
            </div></div>
            <details class="histo" hidden={x.historique.length === 0}><summary>Historique ({x.historique.length})</summary><div class="liste">{x.historique.map((d) => <DocLien doc={d} vers="avions" />)}</div></details>
          </article>
        ))}
      </div>
      </div>
    </section>

    <!-- ADMIN (responsables seulement) -->
    <section class="panneau" id="admin" hidden>
      <h1 class="titre">Administration</h1>
      <div class="outils">
        {outilsAdmin.map((o) => (
          <a class="outil" href={url(o.lien)}>
            <span class="o-logo o-adm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.svg} /></svg></span>
            <span class="o-txt"><b>{o.nom}</b><small>{o.desc}</small></span>
          </a>
        ))}
      </div>
      <button type="button" class="adm-quitter" id="adm-sortir">Quitter le mode admin (déconnexion)</button>
    </section>

    <!-- PRÉPARER -->
    <section class="panneau" id="preparer" hidden>
      <h1 class="titre">Préparer son vol</h1>
      {outils.categories.map((c) => (
        <div class="bloc">
          <h5 class="sep">{c.titre}</h5>
          <div class="outils">
            {c.outils.map((o) => { const interne = (o as { membre?: string }).membre; return (
              <a class="outil" href={interne ? url(interne) : o.lien} target={interne ? undefined : '_blank'} rel={interne ? undefined : 'noopener'} data-q={`${o.nom} ${o.description}`.toLowerCase()}>
                <span class="o-logo" data-init={o.nom.replace(/[^A-Za-zÀ-ÿ0-9]/g, '').slice(0, 2).toUpperCase()}>
                  <img src={(o as { logo?: string }).logo ? asset((o as { logo?: string }).logo!) : `https://www.google.com/s2/favicons?domain=${host(o.lien)}&sz=128`} alt="" width="34" height="34" loading="lazy" onerror="this.remove()" />
                </span>
                <span class="o-txt"><b>{o.nom}{interne ? '' : ' ↗'}</b><small>{o.description}</small></span>
              </a>
            ); })}
          </div>
        </div>
      ))}
      {vivants('Documentation pilote').length > 0 && <div class="bloc"><h5 class="sep">Terrain et espace aérien</h5><div class="liste">{vivants('Documentation pilote').map((d) => <DocLien doc={d} />)}</div></div>}
      {memos.map((x) => <div class="bloc"><h5 class="sep">{x.c}</h5><div class="liste">{x.docs.map((d) => <DocLien doc={d} />)}</div></div>)}
    </section>
  </main>

  <nav class="tabbar" id="onglets" aria-label="Sections">
    {onglets.map((o) => (
      <button type="button" data-onglet={o.id} aria-selected={o.id === 'accueil'} data-admin={o.admin ? '' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.svg} /></svg>
        <span>{o.nom}</span>
      </button>
    ))}
  </nav>

  <dialog class="feuille-msg feuille-notam" id="notam-detail" aria-label="Détail du NOTAM">
    <div class="nd-corps nl"></div>
    <button type="button" class="mc-lu nd-fermer">Fermer</button>
  </dialog>

  <dialog class="feuille-msg" id="msg-club" aria-label="Message du club">
    <div class="mc-corps"></div>
    <button type="button" class="mc-lu" id="mc-lu">J'ai lu</button>
  </dialog>

  <dialog class="modale" id="signalement" aria-label="Signaler un problème technique" data-api={url('/membre/api/signalements')} data-cle-mail={cleFormulaire(club.formulaire_cle)} data-page={url('/membre/signalements/')}>
    <form method="dialog">
      <div class="m-head">
        <h3>Signaler un problème</h3>
        <button type="button" class="m-x" data-fermer aria-label="Fermer">✕</button>
      </div>

      <div class="m-corps" data-etape="saisie">
        <div class="m-avion"><span class="m-av-lbl">Avion</span><span class="m-av-im" id="sig-avion">—</span></div>
        <label for="sig-nom">Votre nom</label>
        <input id="sig-nom" type="text" autocomplete="name" maxlength="60" placeholder="Prénom Nom" />
        <label for="sig-desc">Problème constaté</label>
        <textarea id="sig-desc" rows="4" placeholder="Ex. pneu principal droit usé, radio qui grésille…"></textarea>
        <label>Photos <span class="m-opt">facultatif</span></label>
        <div class="m-photos" id="sig-photos" hidden></div>
        <button type="button" class="m-ajout" id="sig-ajout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-3l-2.5-3z" /><circle cx="12" cy="13" r="3.2" /></svg>
          Ajouter des photos
        </button>
        <input type="file" id="sig-fichiers" accept="image/*" multiple hidden />
        <p class="m-erreur" id="sig-erreur" role="alert" hidden></p>
      </div>

      <div class="m-corps m-reussi" data-etape="ok" hidden>
        <span class="m-ok-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg></span>
        <strong>Signalement envoyé</strong>
        <span id="sig-retour">Les responsables techniques sont prévenus.</span>
        <a class="m-lien" href={url('/membre/signalements/')}>Voir tous les signalements</a>
        <button type="button" class="m-pri" data-fermer>Fermer</button>
      </div>

      <div class="m-pied" id="sig-pied">
        <button type="button" class="m-sec" data-fermer>Annuler</button>
        <button type="button" class="m-pri" id="sig-envoyer">Envoyer</button>
      </div>
    </form>
  </dialog>

  <AdminDocs />
  <script type="application/json" id="admin-donnees" set:html={JSON.stringify(adminDonnees).replace(/</g, '\\u003c')} />
</MembreApp>

<script>
  import { enregistrer, boutonInstaller, seDeconnecter, badges, documentsDeposes, maa, maaEnLigne, onglets, signalement, theme, avions, soleil, flotte, notam, vent, aero } from '../../scripts/membre-app';
  enregistrer();
  theme(document.getElementById('btn-theme'));
  const montrer = onglets();
  badges();
  avions();
  documentsDeposes();
  maa();
  maaEnLigne();
  soleil();
  setInterval(soleil, 60_000);
  flotte();
  notam();
  vent();
  aero();
  setInterval(maaEnLigne, 5 * 60_000); // nouveaux MAA reçus par mail
  setInterval(maa, 60_000); // le MAA peut commencer ou se terminer pendant la consultation
  signalement();
  import('../../scripts/membre-messages').then((m) => m.messagesClub());
  // Quitter le mode admin = se déconnecter : un membre classique se reconnecte avec le mot de passe du club
  document.getElementById('adm-sortir')?.addEventListener('click', () => {
    if (!confirm('Quitter le mode admin ? Vous serez déconnecté ; reconnectez-vous ensuite avec le mot de passe du club.')) return;
    try { localStorage.removeItem('acbt-admin-alertes'); localStorage.removeItem('acbt-admin-jeton'); localStorage.removeItem('acbt-admin-stats'); } catch { /* privé */ }
    seDeconnecter();
  });
  try { if (localStorage.getItem('acbt-admin-jeton')) import('../../scripts/membre-admin').then((m) => m.modeAdmin()); } catch { /* privé */ }
  boutonInstaller(document.getElementById('installer') as HTMLButtonElement, document.getElementById('aide-ios'));
  document.getElementById('deconnexion')?.addEventListener('click', () => {
    if (confirm('Se déconnecter sur cet appareil ? Les documents gardés hors ligne seront effacés.')) seDeconnecter();
  });
  document.querySelectorAll<HTMLElement>('.liste-alerte').forEach((ul) =>
    ul.addEventListener('click', (ev) => { const li = (ev.target as HTMLElement).closest<HTMLElement>('[data-vers]'); if (li?.dataset.vers) montrer?.(li.dataset.vers); }));

  // Recherche (derrière une icône, ne masque pas la barre d'onglets)
  const sw = document.getElementById('searchwrap');
  const q = document.getElementById('q') as HTMLInputElement | null;
  const aucun = document.getElementById('aucun');
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const ouvrir = (o: boolean) => { if (sw) sw.hidden = !o; if (o) q?.focus(); else if (q) { q.value = ''; q.dispatchEvent(new Event('input')); } };
  document.getElementById('btn-recherche')?.addEventListener('click', () => ouvrir(sw?.hidden ?? true));
  document.getElementById('fermer-recherche')?.addEventListener('click', () => ouvrir(false));
  q?.addEventListener('input', () => {
    const v = norm(q.value.trim());
    document.body.classList.toggle('recherche', !!v);
    document.querySelectorAll<HTMLElement>('[data-q]').forEach((el) => { el.hidden = !!v && !norm(el.dataset.q || '').includes(v); });
    if (aucun) aucun.hidden = !v || !!document.querySelector('[data-q]:not([hidden])');
  });
</script>

<style>
  .titre { font-size: 1.4rem; margin: 0 0 16px; letter-spacing: -.01em; }
  .bt { font-size: .82rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 700; margin: 0 0 10px; display: flex; align-items: center; gap: 9px; }
  .sep { font-size: .74rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 700; margin: 22px 0 10px; }
  .sep-col { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .sep-col span { flex: none; font-size: .68rem; letter-spacing: .04em; text-transform: none; font-weight: 600; padding-right: 15px; }
  .sep:first-of-type, .fiche .sep:first-of-type { margin-top: 0; }

  /* Barre du haut */
  /* Barre du haut FIXE (et non « sticky ») : iOS prolonge alors son bleu sous l'heure et la batterie au lieu d'y flouter la page */
  :global(body) { padding-top: calc(54px + env(safe-area-inset-top, 0px)); }
  .topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: calc(54px + env(safe-area-inset-top, 0px)); padding: 0 14px; padding-top: env(safe-area-inset-top, 0px); background: var(--bar); color: var(--bar-ink); }
  .marque { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--bar-ink); --logo-rouge: var(--bar-rouge); --logo-h: 40px; }
  .marque .logo { --logo-h: 30px; --logo-rouge: var(--bar-rouge); color: var(--bar-ink); }
  .marque span { font-weight: 800; font-size: 1.05rem; letter-spacing: -.01em; white-space: nowrap; }
  .actions { display: flex; gap: 2px; }  /* comme Perfs : boutons 36 × 38, 2 px d'écart */
  .cloche .barre { display: inline; }
  .cloche.on .barre { display: none; }
  .cloche.on { color: #f5c400; }
  .feuille-msg { margin: auto auto 0; width: min(560px, 100vw); max-width: 100vw; max-height: 85dvh; border: 0; border-radius: 22px 22px 0 0; padding: 22px 20px calc(18px + env(safe-area-inset-bottom, 0px)); background: var(--surface); color: var(--ink); box-shadow: 0 -20px 60px rgba(14,26,43,.3); overflow: auto; }
  /* Détail d'un NOTAM (toucher une ligne de l'onglet NOTAM) */
  .nl :global(.n) { cursor: pointer; }
  @media (hover: hover) { .nl :global(.n:hover) { background: var(--surface-2); border-radius: 10px; } }
  @media (min-width: 700px) { .feuille-notam { margin: auto; border-radius: 22px; } }
  .feuille-notam :global(.nd-tete) { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; }
  .feuille-notam :global(.nd-tete b) { display: block; font-size: 1.1rem; }
  .feuille-notam :global(.nd-tete span:not(.ic)) { color: var(--muted); font-size: .85rem; font-weight: 700; font-family: var(--mono); }
  .feuille-notam :global(.nd-tete em) { font-style: normal; font-size: .72rem; font-weight: 800; letter-spacing: .06em; padding: 4px 9px; border-radius: 99px; background: var(--surface-2); color: var(--muted); }
  .feuille-notam :global(.nd-tete em.on) { background: var(--bad-bg); color: var(--bad); }
  .feuille-notam :global(.nd-dates) { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 16px 0; }
  .feuille-notam :global(.nd-dates div) { background: var(--surface-2); border-radius: 12px; padding: 10px 12px; }
  .feuille-notam :global(dt) { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .feuille-notam :global(dd) { margin: 3px 0 0; font-weight: 800; font-variant-numeric: tabular-nums; }
  .feuille-notam :global(dd small) { display: block; font-weight: 600; color: var(--muted); font-size: .8rem; margin: 2px 0 0; }
  .feuille-notam :global(.nd-horaires) { background: var(--warn-bg, var(--surface-2)); border: 1px solid var(--warn-line, var(--line)); border-radius: 12px; padding: 10px 12px; margin: -6px 0 16px; }
  .feuille-notam :global(.nd-brut-t) { margin: 16px 0 6px; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .feuille-notam :global(.nd-brut) { margin: 0; font-family: var(--mono); font-size: .92rem; line-height: 1.55; color: var(--ink); white-space: pre-wrap; overflow-wrap: anywhere; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .feuille-notam :global(.nd-texte) { font-family: var(--mono); font-size: .95rem; line-height: 1.55; background: var(--surface-2); border-left: 4px solid var(--accent); border-radius: 10px; padding: 12px 14px; margin: 0; overflow-wrap: anywhere; }
  .feuille-notam :global(.nd-texte em) { font-style: normal; font-weight: 800; color: var(--bad); }
  .feuille-msg::backdrop { background: rgba(14,26,43,.55); backdrop-filter: blur(3px); }
  .feuille-msg :global(.mc-tag) { display: inline-block; background: #fff2b8; color: #7a5a00; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 8px; }
  .feuille-msg :global(h3) { font-size: 1.35rem; line-height: 1.2; margin: 12px 0 8px; }
  .feuille-msg :global(p) { margin: 0 0 10px; line-height: 1.5; color: var(--ink2, var(--ink)); overflow-wrap: anywhere; }
  .feuille-msg :global(small) { display: block; color: var(--muted); font-size: .86rem; margin-top: 4px; }
  .feuille-msg :global(.mc-n) { margin-top: 10px; font-weight: 700; }
  .mc-lu { width: 100%; min-height: 50px; margin-top: 16px; border: 0; border-radius: 12px; background: var(--navy); color: #fff; font: inherit; font-weight: 800; font-size: 1.02rem; cursor: pointer; }
  :global(.bulle-notif) { position: fixed; right: 12px; z-index: 60; max-width: min(320px, calc(100vw - 24px)); background: var(--navy); color: #fff; font-size: .88rem; font-weight: 650; padding: 10px 13px; border-radius: 10px; box-shadow: 0 10px 30px rgba(14,26,43,.3); }
  .ic { width: 36px; height: 38px; border: 0; background: transparent; color: var(--bar-ic); display: grid; place-items: center; border-radius: 10px; cursor: pointer; }
  /* Mêmes icônes que Perfs : 18 px, trait 2. :global car l'icône du thème est injectée en JS (sans attribut de portée) */
  .ic :global(svg) { width: 18px; height: 18px; }
  .ic:active { background: rgba(255,255,255,.12); }

  /* Recherche */
  .searchwrap { position: sticky; top: calc(54px + env(safe-area-inset-top, 0px)); z-index: 29; display: flex; gap: 8px; padding: 10px 14px; background: var(--surface); border-bottom: 1px solid var(--line); }
  .searchwrap input { flex: 1; min-width: 0; padding: 11px 14px; border: 1px solid var(--line); border-radius: 12px; font: inherit; background: var(--surface-2); }
  .searchwrap input:focus { outline: 2px solid var(--accent); outline-offset: 0; }
  .searchwrap button { border: 0; background: var(--surface-2); border-radius: 12px; width: 44px; font-size: 1rem; color: var(--muted); cursor: pointer; }
  .aucun { padding: 24px 16px; color: var(--muted); text-align: center; }

  /* Contenu + onglets */
  .content { padding: 18px 14px calc(var(--tab-h) + var(--safe-b) + 20px); max-width: 760px; margin: 0 auto; }
  :global(body.recherche) .panneau[hidden] { display: block !important; }
  :global(body.recherche) .panneau { margin-bottom: 8px; }

  .tabbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; display: flex; background: var(--surface); border-top: 1px solid var(--line); padding-bottom: var(--safe-b); box-shadow: 0 -2px 14px rgba(14,26,43,.06); }
  .tabbar button { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; border: 0; background: none; color: var(--muted); font: inherit; font-size: .68rem; font-weight: 600; padding: 9px 2px; cursor: pointer; min-height: var(--tab-h); }
  /* iPhone (appli installée) : iOS laisse parfois une bande sous la barre ; on prolonge la barre vers le bas pour la couvrir */
  .tabbar::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 140px; background: var(--surface); pointer-events: none; }
  .tabbar svg { width: 23px; height: 23px; }
  .tabbar button[aria-selected='true'] { color: var(--accent); font-weight: 800; }
  .tabbar button[aria-selected='true'] svg { stroke-width: 2.3; }
  .tabbar button[aria-selected='true']::before { content: ''; position: absolute; top: 0; left: 28%; right: 28%; height: 3px; border-radius: 0 0 3px 3px; background: var(--yellow); }

  /* MAA */
  #maa-zone { margin-bottom: 18px; display: grid; gap: 9px; }
  /* Rien en cours : même bandeau que la TV (« Aucune alerte météo » en vert, le détail en texte normal) */
  .maa-rien { display: flex; align-items: center; gap: 10px; margin: 0 0 18px; padding: 11px 16px; border-radius: 999px; background: var(--ok-bg); border: 1px solid var(--ok-line); color: var(--ink); font-size: .9rem; line-height: 1.35; }
  .maa-rien[hidden] { display: none; }
  .maa-rien b { color: var(--ok); font-weight: 800; margin-right: 4px; }
  .maa-rien-s { font-weight: 600; }
  @media (max-width: 600px) { .maa-rien { border-radius: 16px; } .maa-rien-s { display: block; } } /* téléphone : le détail passe à la ligne */
  .maa-rien-pt { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--ok); }
  .snow-alerte { display: flex; gap: 10px; align-items: center; color: #fff; background: linear-gradient(135deg, #c4161c, #e4482b); border-radius: 14px; padding: 11px 13px; margin-bottom: 10px; }
  .snow-alerte[hidden] { display: none; }
  .maa-banniere { display: flex; gap: 10px; align-items: center; text-decoration: none; color: #fff; background: linear-gradient(135deg, #c4161c, #e4482b); border-radius: 14px; padding: 11px 13px; box-shadow: 0 5px 16px rgba(196,22,28,.26); }
  .maa-banniere[data-etat='a-venir'] { background: linear-gradient(135deg, #b5700a, #e0982a); box-shadow: 0 5px 16px rgba(181,112,10,.26); }
  .maa-banniere .maa-ic { flex: none; width: 30px; height: 30px; display: grid; place-items: center; background: rgba(255,255,255,.18); border-radius: 50%; }
  .maa-banniere .maa-ic svg { width: 18px; height: 18px; }
  .maa-txt { flex: 1; min-width: 0; display: grid; gap: 1px; }
  .maa-txt strong { font-size: .82rem; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .maa-num { font-size: .8rem; font-weight: 700; opacity: .95; font-variant-numeric: tabular-nums; }
  .lvp-banniere { display: flex; gap: 10px; align-items: center; color: #fff; background: linear-gradient(135deg, #c4161c, #e4482b); border-radius: 14px; padding: 11px 13px; box-shadow: 0 5px 16px rgba(196,22,28,.26); margin-bottom: 10px; }
  .lvp-banniere[hidden] { display: none; }
  .lvp-logo { flex: none; font-weight: 900; font-size: .78rem; letter-spacing: .04em; color: #c4161c; background: #fff; border-radius: 7px; padding: 6px 7px; line-height: 1; }
  .maa-pdf { flex: none; font-size: .7rem; font-weight: 700; background: rgba(255,255,255,.2); padding: 5px 8px; border-radius: 8px; }

  .carte-metar { padding: 15px 16px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 14px; }
  .carte-taf { margin-top: 14px; }
  .carte-aeroweb { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; padding: 13px 16px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 14px; color: inherit; text-decoration: none; }
  .carte-aeroweb b { display: block; font-size: 15px; }
  .carte-aeroweb small { display: block; margin-top: 2px; color: var(--muted, #55607a); font-size: 13px; }
  .carte-aeroweb .fl { font-size: 18px; color: var(--accent); }
  .carte-aeroweb:hover { border-color: var(--accent); }

  /* Vent et pistes : même rose des vents et mêmes composantes que le tableau de bord TV */
  .bt-suite { margin-top: 22px; }
  .bt-nb :global(.dot) { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); vertical-align: 0; }
  .bt-nb :global(.dot.ko) { background: var(--bad); }
  /* Onglet Météo : blocs empilés avec un écart régulier */
  #accueil:not([hidden]) { display: flex; flex-direction: column; gap: 12px; }
  #accueil > *, .vue-meteo .col-g > *, .vue-meteo .col-d > * { margin: 0 !important; }
  .vue-meteo[hidden] { display: none !important; }
  .vue-terrain { display: flex; flex-direction: column; gap: 12px; }
  .vue-meteo .col-g, .vue-meteo .col-d { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  /* Vent et altitude : une carte, titre compris */
  .bloc-vent, .bloc-alt { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px 10px; }
  .bloc-vent > .bt-suite, .bloc-alt > .bt-suite { margin: 0 2px 8px !important; }
  .bloc-vent > .bt { white-space: nowrap; } .bloc-vent > .bt .bt-nb { white-space: normal; text-align: right; }
  /* Tablette et PC : deux colonnes alignées en haut ; voisins sur deux colonnes */
  /* Téléphone : une colonne, vents en altitude juste sous Vent et pistes (sur PC/tablette, ils passent sous les METAR voisins) */
  @media (max-width: 759px) {
    .vue-meteo .col-g, .vue-meteo .col-d { display: contents; }
    .bloc-vent { order: 1; } .bloc-alt { order: 2; } .vue-meteo .col-d > :not(.bloc-alt) { order: 3; }
  }
  @media (min-width: 760px) {
    .vue-terrain { flex-direction: row; align-items: flex-start; gap: 14px; }
    .vue-meteo .col-g { flex: .9; } .vue-meteo .col-d { flex: 1.15; }
  }
  /* Tablette en portrait : deux colonnes égales, tableau d'altitude resserré (température sous le vent) */
  @media (min-width: 760px) and (max-width: 1099px) {
    .vue-meteo .col-g, .vue-meteo .col-d { flex: 1; }
    .carte-alt :global(.alt th) { font-size: .64rem; padding-inline: 2px; }
    .carte-alt :global(.alt td) { font-size: .86rem; padding-inline: 2px; }
    .carte-alt :global(.alt .t) { display: block; font-size: .76rem; }
    .bloc-vent > .bt, .bloc-alt > .bt { flex-wrap: wrap; white-space: normal; }
  }
  .carte-alt { border: 0; padding: 0; background: none; }
  .carte-vent { border: 0; padding: 0; background: none; }
  .carte-alt { overflow-x: auto; }
  .carte-alt :global(.alt) { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .carte-alt :global(.alt th) { font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); text-align: center; padding: 0 4px 6px; }
  .carte-alt :global(.alt th:first-child) { text-align: left; }
  .carte-alt :global(.alt td) { padding: 7px 4px; border-top: 1px solid var(--line); font-size: .95rem; font-weight: 700; white-space: nowrap; text-align: center; color: var(--ink); }
  .carte-alt :global(.alt td:first-child) { font-family: var(--mono); text-align: left; }
  .carte-alt :global(.alt .fl) { display: inline-block; width: 15px; height: 15px; vertical-align: -2px; margin-right: 4px; color: var(--accent); }
  .carte-alt :global(.alt .t) { color: var(--muted); font-weight: 600; }
  @media (max-width: 480px) {
    .carte-alt { padding-inline: 8px; }
    .carte-alt :global(.alt th) { font-size: .62rem; letter-spacing: .02em; padding-inline: 2px; }
    .carte-alt :global(.alt td) { font-size: .8rem; padding-inline: 2px; }
    .carte-alt :global(.alt .fl) { width: 11px; height: 11px; margin-right: 2px; vertical-align: -1px; }
    .carte-alt :global(.alt .t) { display: block; font-size: .72rem; }
  }
  /* METAR voisins : chaque terrain dans une carte identique à celle du METAR LFOB (même bord, même retrait, même police) */
  /* METAR voisins : un seul encadré, comme sur le tableau de bord TV (une ligne grisée par terrain, bord coloré selon la catégorie) */
  .bloc-voisins { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px 14px; }
  .bloc-voisins > .bt-suite { margin: 0 2px 10px !important; }
  .carte-voisins { display: grid; gap: 8px; padding: 0 !important; background: none !important; border: 0 !important; }
  .carte-voisins :global(.mv) { line-height: 1.35; padding: 7px 10px 7px 12px; background: var(--surface-2); border-left: 4px solid var(--k, var(--muted)); border-radius: 8px; color: var(--muted); font-size: .85rem; }
  .carte-voisins :global(.mv b) { font-family: var(--mono); font-weight: 700; font-size: .85rem; color: var(--ink); }
  .carte-voisins :global(.mv .nm) { font-weight: 700; color: var(--muted); font-size: .75rem; margin-left: 6px; }
  .carte-voisins :global(.mv br) { display: none; }
  .carte-voisins :global(.mv .mr) { display: block; margin-top: 2px; font-family: var(--mono); font-size: .83rem; color: var(--ink); overflow-wrap: anywhere; }
  /* Téléphone : « (seuil 30) » retiré pour que la station tienne sur une ligne */
  @media (max-width: 600px) { .bt-nb :global(.seuil) { display: none; } }
  #voisins-h { display: flex; gap: 10px; }
  #voisins-h :global(.lgc) { display: inline-flex; align-items: center; gap: 4px; }
  #voisins-h :global(.lgc i) { width: 8px; height: 8px; border-radius: 50%; background: var(--k); }
  .bloc-voisins :global(.VFR) { --k: var(--ok); } .bloc-voisins :global(.MVFR) { --k: var(--accent); } .bloc-voisins :global(.IFR) { --k: var(--bad); } .bloc-voisins :global(.LIFR) { --k: #c050ff; }
  .carte-vent > .vide { color: var(--muted); font-size: .86rem; font-weight: 600; margin: 0; padding: 8px 4px; }
  .carte-vent :global(.vd) { display: flex; flex-direction: column; align-items: center; }
  .carte-vent :global(.vd .t) { display: flex; align-items: baseline; gap: 12px; font-size: 1.7rem; font-weight: 800; line-height: 1.05; color: var(--ink); }
  .carte-vent :global(.vd .t .sep) { align-self: center; width: 2px; height: 22px; border-radius: 2px; background: var(--muted); opacity: .45; }
  .carte-vent :global(.vd .t small) { font-size: .8rem; font-weight: 700; color: var(--muted); }
  .carte-vent :global(.vd .vraf) { margin-top: 3px; font-size: .85rem; font-weight: 700; color: var(--warn); text-align: center; }
  .carte-vent :global(.vd .vtemp) { margin-top: 4px; font-size: .88rem; font-weight: 600; color: var(--muted); display: flex; align-items: baseline; justify-content: center; gap: 5px; }
  .carte-vent :global(.vd .vtemp b) { color: var(--ink); font-weight: 800; font-variant-numeric: tabular-nums; }
  .carte-vent :global(.vd .vtemp i) { width: 1px; height: .9em; margin: 0 5px; align-self: center; background: var(--muted); opacity: .5; }
  .carte-vent :global(.vd .vsous) { margin-top: 4px; font-size: .8rem; font-weight: 700; color: var(--muted); text-align: center; }
  .carte-vent :global(.vd svg) { width: min(100%, 220px); aspect-ratio: 1; margin-top: 4px; }
  .carte-vent :global(.cone) { transition: transform 2.5s cubic-bezier(.4, 0, .2, 1); }
  .carte-vent :global(.qfus) { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 6px; }
  .carte-vent :global(.qfu) { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 6px; align-items: center; background: var(--surface-2); border: 1px solid transparent; border-radius: 10px; padding: 6px 7px; }
  .carte-vent :global(.qfu .n) { font-family: var(--mono); font-size: 1.02rem; font-weight: 700; color: var(--muted); line-height: 1.1; }
  .carte-vent :global(.qfu .n i) { display: block; font-style: normal; font-size: .56rem; font-weight: 600; opacity: .8; }
  .carte-vent :global(.qfu b) { display: block; font-size: .8rem; font-weight: 800; color: var(--ink); white-space: nowrap; }
  .carte-vent :global(.qfu small) { display: block; font-size: .64rem; color: var(--muted); font-weight: 600; white-space: nowrap; letter-spacing: -.01em; }
  .carte-vent :global(.qfu.co) { border-color: var(--ok); background: var(--ok-bg); }
  .carte-vent :global(.qfu.co .n), .carte-vent :global(.qfu.co b) { color: var(--ok); }
  .carte-vent :global(.qfu.arr b) { color: var(--warn); }
  .carte-vent :global(.qfu .att) { width: 14px; height: 14px; color: var(--warn); vertical-align: -2px; margin-right: 4px; }

  /* NOTAM : même liste que le tableau de bord TV (badges par catégorie, mots d'indisponibilité en rouge), sans défilement */
  #notam .titre { display: flex; align-items: baseline; gap: 10px; }
  #notam .titre .bt-nb { color: var(--muted); }
  .bt-nb { margin-left: auto; text-transform: none; letter-spacing: 0; font-weight: 600; font-size: .74rem; }
  .carte-notam { padding: 2px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; }
  .nl :global(.n) { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .nl :global(.n:last-child) { border-bottom: 0; }
  .nl :global(.ic) { width: 40px; height: 27px; border-radius: 6px; display: grid; place-items: center; font-weight: 900; font-size: 15px; color: #111; background: #f5c518; box-shadow: inset 0 0 0 2px #111, 0 0 0 1px #f5c518; letter-spacing: -.5px; }
  .nl :global(.ic svg) { width: 19px; height: 19px; }
  .nl :global(.ic.l3) { font-size: 11.5px; letter-spacing: .3px; }
  .nl :global(.ic.l4) { font-size: 9.5px; letter-spacing: .2px; }
  .nl :global(.ic.rouge) { background: #e0364f; color: #fff; box-shadow: inset 0 0 0 2px #fff3, 0 0 0 1px #e0364f; }
  .nl :global(.ic.bleu) { background: #1e9bff; color: #fff; box-shadow: none; }
  .nl :global(.ic.violet) { background: #8b6cff; color: #fff; box-shadow: none; }
  .nl :global(.ic.neige) { background: #e8f6ff; color: #0b5fa5; box-shadow: inset 0 0 0 2px #0b5fa5; }
  .nl :global(.ic.gris) { background: var(--surface-2); color: var(--ink-2); box-shadow: inset 0 0 0 1.5px var(--muted); }
  .nl :global(b) { display: block; font-size: .86rem; font-weight: 700; line-height: 1.4; color: var(--ink); overflow-wrap: anywhere; }
  .nl :global(b em) { font-style: normal; color: var(--bad); }
  .nl :global(b .no) { font-weight: 600; color: var(--muted); font-size: .74rem; white-space: nowrap; }
  .nl :global(small) { display: block; color: var(--muted); font-size: .76rem; font-weight: 600; margin-top: 4px; }
  .nl :global(.cren) { display: inline-block; font-size: .72rem; font-weight: 800; color: var(--warn); background: var(--warn-bg); border: 1px solid var(--warn-line); border-radius: 5px; padding: 0 6px; margin-right: 7px; }
  .nl :global(.actif) { display: inline-block; font-size: .62rem; font-weight: 900; letter-spacing: .6px; color: #fff; background: #23a55a; border-radius: 5px; padding: 1px 6px; margin-right: 7px; vertical-align: 1px; }
  .nl :global(.vide) { color: var(--muted); font-size: .86rem; font-weight: 600; padding: 14px 0; margin: 0; }

  /* Soleil (onglet Météo, sous le MAA) : frise des 24 h comme le tableau de bord, sans aube ni crépuscule */
  .soleil { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 30px 14px 10px; }
  .sol-frise { position: relative; height: 22px; border-radius: 7px; background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--muted) 35%, transparent) 0 2px, transparent 2px 7px), var(--surface-2); }
  .sol-frise .a { position: absolute; top: 0; bottom: 0; border-radius: 7px; box-shadow: inset 0 0 0 2px #e2a400; background: color-mix(in srgb, var(--accent) 25%, var(--surface)); }
  .sol-frise .j { position: absolute; top: 3px; bottom: 3px; border-radius: 4px; background: var(--accent); }
  .sol-frise .now { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: #e5484d; border-radius: 2px; }
  .sol-frise .now em { position: absolute; bottom: 100%; left: 50%; transform: translate(-50%, -2px); font-style: normal; font-size: .68rem; font-weight: 800; color: #fff; background: #e5484d; padding: 1px 5px; border-radius: 4px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sol-graduations { display: flex; justify-content: space-between; margin: 4px 0 8px; font-size: .66rem; font-weight: 600; color: var(--muted); }
  .sol-cases { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); padding-top: 8px; }
  .sol-cases > div { text-align: center; }
  .soleil small { display: block; color: var(--muted); font-size: .7rem; font-weight: 600; white-space: nowrap; }
  .soleil .sol-cases b { font-size: 1.05rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .sol-cases .aero b span { color: #c98f00; }
  #maa-zone:not([hidden]), .maa-rien:not([hidden]) { margin-bottom: 12px; }

  /* Flotte */
  .fl-liste { display: grid; gap: 12px; }
  @media (min-width: 640px) { .fl-liste { grid-template-columns: 1fr 1fr; } }
  :global(.fl-carte) { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; }
  :global(.fl-tete) { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  :global(.fl-im) { font-family: var(--mono); font-size: 1.05rem; font-weight: 700; letter-spacing: .02em; }
  :global(.fl-tete small) { color: var(--muted); font-size: .78rem; font-weight: 600; margin-left: 8px; }
  :global(.fl-etat) { display: inline-flex; align-items: center; gap: 6px; font-size: .74rem; font-weight: 700; padding: 3px 10px; border-radius: 99px; border: 1px solid; white-space: nowrap; }
  :global(.fl-etat i) { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  :global(.fl-etat.fl-ok) { color: var(--ok); background: var(--ok-bg); border-color: var(--ok-line); }
  :global(.fl-etat.fl-bad) { color: var(--bad); background: var(--bad-bg); border-color: var(--bad-line); }
  :global(.fl-etat.fl-info) { color: var(--accent-text, var(--accent)); background: var(--accent-soft); border-color: var(--accent-line, var(--line)); }
  /* Carte B1 : cadran du potentiel + lignes ; chaque texte sur une seule ligne */
  :global(.fl-l) { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  :global(.fl-tete > .fl-l) { flex: 1; }
  :global(.fl-etat) { flex: none; }
  :global(.fl-lbl) { font-size: .66rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  :global(.fl-lbl.fl-vert) { color: var(--ok); }
  :global(.fl-lbl.fl-rouge) { color: var(--bad); }
  :global(.fl-jour) { font-size: .75rem; font-weight: 700; color: var(--muted); }
  :global(.fl-nom) { font-size: .82rem; font-weight: 600; color: var(--ink-2, var(--ink)); }
  :global(.fl-gros) { font-size: 1.5rem; font-weight: 800; line-height: 1.15; font-variant-numeric: tabular-nums; }
  :global(.fl-g) { min-width: 0; }
  :global(.fl-haut) { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 14px; align-items: center; margin-top: 12px; }
  :global(.fl-cadran) { width: 96px; height: 96px; position: relative; }
  :global(.fl-cadran svg) { width: 100%; height: 100%; transform: rotate(-90deg); }
  :global(.fl-cadran circle) { fill: none; stroke: var(--surface-2); stroke-width: 4; }
  :global(.fl-cadran .fl-arc) { stroke: var(--muted); stroke-linecap: round; }
  :global(.fl-cadran.fl-ok .fl-arc) { stroke: var(--ok); }
  :global(.fl-cadran.fl-warn .fl-arc) { stroke: var(--warn); }
  :global(.fl-cadran.fl-bad .fl-arc) { stroke: var(--bad); }
  :global(.fl-cadran div) { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  :global(.fl-cadran b) { font-size: 1.25rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
  :global(.fl-cadran small) { font-size: .6rem; color: var(--muted); font-weight: 700; margin-top: 3px; }
  :global(.fl-cadran.fl-warn b) { color: var(--warn); }
  :global(.fl-cadran.fl-bad b) { color: var(--bad); }
  :global(.fl-lignes) { margin-top: 12px; border-top: 1px solid var(--line); }
  :global(.fl-r) { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  :global(.fl-r:last-child) { border-bottom: 0; padding-bottom: 0; }
  /* Lignes sous le cadran : liseré + léger dégradé selon le type (bleu réservation, vert dispo, gris dernier vol) */
  :global(.fl-lignes) { border-top: 0; display: grid; gap: 6px; }
  :global(.fl-r[class*="fl-r-"]) { position: relative; overflow: hidden; border: 0; border-radius: 10px; padding: 9px 12px 9px 14px; }
  :global(.fl-r[class*="fl-r-"]:last-child) { padding-bottom: 9px; }
  :global(.fl-r[class*="fl-r-"])::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; }
  :global(.fl-r-resa) { background: linear-gradient(90deg, var(--accent-soft), transparent 85%); }
  :global(.fl-r-resa)::before { background: var(--accent); }
  :global(.fl-r-dispo) { background: linear-gradient(90deg, var(--ok-bg), transparent 85%); }
  :global(.fl-r-dispo)::before { background: var(--ok); }
  :global(.fl-r-dernier) { background: linear-gradient(90deg, var(--surface-2), transparent 85%); }
  :global(.fl-r-dernier)::before { background: var(--muted); }
  :global(.fl-h) { text-align: right; font-size: 1rem; font-weight: 800; white-space: nowrap; align-self: center; font-variant-numeric: tabular-nums; }
  :global(.fl-h small) { display: block; font-size: .7rem; color: var(--muted); font-weight: 700; }
  /* « Prochaine dispo. > 30' » toujours en entier : le petit texte de droite passe à la ligne si besoin */
  :global(.fl-r .fl-lbl) { overflow: visible; text-overflow: clip; }
  :global(.fl-r .fl-g) { min-width: max-content; }
  :global(.fl-h) { min-width: 0; }
  :global(.fl-h small) { white-space: normal; }
  :global(.fl-tol) { margin: 8px 0 0; font-size: .72rem; color: var(--muted); font-weight: 600; }
  /* Avion indisponible (maintenance) : carte hachurée en diagonale + bandeau */
  :global(.fl-carte.fl-hs) { background: var(--surface) repeating-linear-gradient(135deg, transparent 0 12px, color-mix(in srgb, var(--bad) 8%, transparent) 12px 14px); border-color: var(--bad-line); }
  :global(.fl-hs .fl-cadran) { opacity: .55; }
  :global(.fl-hs .fl-cadran .fl-arc) { stroke: var(--muted); }
  :global(.fl-hs .fl-cadran b) { color: var(--muted); }
  .fl-info { margin: 12px 2px 0; font-size: .74rem; color: var(--muted); text-align: center; }
  :global(.fl-vide) { color: var(--muted); text-align: center; padding: 24px 8px; background: var(--surface); border: 1px dashed var(--line); border-radius: 14px; margin: 0; }

  /* Alerte documents */
  .alerte-docs { margin: 0; }
  .alerte-docs [data-pleine] { margin-bottom: 18px; }
  .bt-rouge { color: var(--bad); }
  .pt-alerte { flex: none; width: 22px; height: 22px; border-radius: 50%; background: var(--bad); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: .8rem; }
  .liste-alerte { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  :global(.liste-alerte .al) { display: flex; gap: 10px; align-items: center; padding: 11px 13px; border-radius: 12px; border: 1px solid; font-size: .9rem; cursor: pointer; }
  :global(.liste-alerte .al[hidden]) { display: none; }
  :global(.liste-alerte .al-t) { flex: 1; min-width: 0; }
  :global(.liste-alerte .al-e) { flex: none; font-weight: 700; font-size: .82rem; white-space: nowrap; }
  :global(.liste-alerte .pt) { flex: none; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  :global(.liste-alerte .al-expire) { color: var(--bad); background: var(--bad-bg); border-color: var(--bad-line); }
  :global(.liste-alerte .al-bientot) { color: var(--warn); background: var(--warn-bg); border-color: var(--warn-line); }
  :global(.liste-alerte b) { color: var(--ink); }
  .ok { display: flex; align-items: center; gap: 10px; color: var(--ok); background: var(--ok-bg); border: 1px solid var(--ok-line); border-radius: 12px; padding: 12px 15px; margin: 0; font-weight: 600; font-size: .92rem; }
  .ok svg { width: 20px; height: 20px; flex: none; }

  .aide-ios { font-size: .88rem; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin: 10px 0 0; }



  /* Sélecteur avion — menu déroulant façon « vue flotte » */
  .av-lbl { display: block; font-size: .74rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); margin: 2px 0 8px; }
  .av-select { position: relative; margin: 0 0 18px; }
  /* Liste ouverte : le reste de l'écran est flouté et assombri pour faire ressortir la liste */
  .av-voile { position: fixed; inset: 0; z-index: 40; background: rgba(8,16,36,.32); -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); opacity: 0; pointer-events: none; transition: opacity .15s ease; }
  .av-voile:has(+ .av-select .av-trig[aria-expanded='true']) { opacity: 1; pointer-events: auto; }
  .av-select:has(.av-trig[aria-expanded='true']) { z-index: 41; }
  .av-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .av-dot.av-ok { background: var(--ok); } .av-dot.av-warn { background: var(--warn); } .av-dot.av-bad { background: var(--bad); }
  .av-st { font-size: .82rem; font-weight: 700; flex: none; }
  .av-st.av-ok { color: var(--ok); } .av-st.av-warn { color: var(--warn); } .av-st.av-bad { color: var(--bad); }

  .av-trig { display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 13px 14px; box-shadow: var(--shadow); color: var(--ink); font: inherit; cursor: pointer; }
  .av-trig:active { transform: scale(.995); }
