---
import MembreApp from '../../layouts/MembreApp.astro';
import { url } from '../../lib/utils';
// Sur Cloudflare, le vrai mot de passe est vérifié : on retire la mention « version d'essai ».
const essai = !process.env.CF_PAGES;
---
<MembreApp title="Connexion">
  <section class="connexion">
    <form class="boite" id="form" novalidate>
      <img src={url('/icones/membre-192.png')} alt="" width="76" height="76" />
      <h1>ACBT Pilotes</h1>
      <p class="intro">Outils et documents des pilotes de l'ACBT.</p>
      <label for="mdp">Mot de passe du club</label>
      <div class="champ">
        <input id="mdp" name="mdp" type="password" autocomplete="current-password" required />
        <button type="button" class="voir" id="voir" aria-label="Afficher le mot de passe">Voir</button>
      </div>
      <p class="erreur" id="erreur" role="alert" hidden></p>
      <button class="envoyer" type="submit" id="envoyer">Se connecter</button>
      <p class="aide">Le mot de passe est donné par le bureau du club. Vous restez connecté sur cet appareil.</p>
      {essai && <p class="maquette">Version d'essai : n'importe quel mot suffit (le vrai mot de passe sera activé avec Cloudflare).</p>}

      <div class="installer">
        <button type="button" class="btn-install" id="installer" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M12 7v7M9 11l3 3 3-3M10.5 18.5h3" /></svg>
          Installer l'appli sur ce téléphone
        </button>
        <p class="aide-ios" id="aide-ios" hidden>Sur iPhone : touchez <b>Partager</b> en bas de Safari, puis <b>Sur l'écran d'accueil</b>.</p>
      </div>
    </form>
  </section>
</MembreApp>

<script>
  import { seConnecter, estConnecte, enregistrer, boutonInstaller } from '../../scripts/membre-app';
  import { url } from '../../lib/utils';
  const retour = () => {
    const r = new URLSearchParams(location.search).get('retour') || '';
    return r.startsWith(url('/membre/')) ? r : url('/membre/');
  };
  enregistrer();
  boutonInstaller(document.getElementById('installer') as HTMLButtonElement, document.getElementById('aide-ios'));
  if (estConnecte()) location.replace(retour());

  const form = document.getElementById('form') as HTMLFormElement;
  const mdp = document.getElementById('mdp') as HTMLInputElement;
  const erreur = document.getElementById('erreur')!;
  const envoyer = document.getElementById('envoyer') as HTMLButtonElement;
  document.getElementById('voir')!.addEventListener('click', (e) => {
    const montrer = mdp.type === 'password';
    mdp.type = montrer ? 'text' : 'password';
    (e.currentTarget as HTMLElement).textContent = montrer ? 'Cacher' : 'Voir';
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erreur.hidden = true;
    if (!mdp.value.trim()) { erreur.textContent = 'Saisissez le mot de passe du club.'; erreur.hidden = false; mdp.focus(); return; }
    envoyer.disabled = true;
    envoyer.textContent = 'Connexion…';
    const r = await seConnecter(mdp.value);
    if (r === 'ok' || r === 'maquette') { location.replace(retour()); return; }
    erreur.textContent = r === 'refuse' ? 'Mot de passe incorrect. Vérifiez auprès du bureau du club.' : 'Connexion impossible pour le moment. Réessayez dans un instant.';
    erreur.hidden = false;
    envoyer.disabled = false;
    envoyer.textContent = 'Se connecter';
    mdp.select();
  });
</script>

<style>
  .connexion { min-height: 100svh; display: flex; justify-content: center; align-items: center; padding: 40px 16px; background: radial-gradient(ellipse at top, var(--accent-soft), var(--bg) 70%); }
  .boite { width: 100%; max-width: 400px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 30px 24px; box-shadow: 0 24px 60px rgba(14,26,43,.10); text-align: center; }
  .boite > img { border-radius: 18px; margin: 0 auto 14px; display: block; }
  h1 { font-size: 1.5rem; margin: 0 0 4px; }
  .intro { color: var(--muted); margin: 0 0 24px; font-size: .95rem; }
  label { display: block; text-align: left; font-weight: 600; font-size: .9rem; margin-bottom: 6px; }
  .champ { display: flex; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .champ:focus-within { outline: 2px solid var(--accent); outline-offset: 1px; }
  .champ input { flex: 1; min-width: 0; border: 0; padding: 13px 14px; font: inherit; font-size: 1.05rem; outline: none; background: transparent; }
  .voir { border: 0; background: transparent; color: var(--accent); font: inherit; font-weight: 600; font-size: .88rem; padding: 0 14px; cursor: pointer; }
  .erreur { color: var(--bad); background: var(--bad-bg); border: 1px solid var(--bad-line); border-radius: 10px; padding: 9px 12px; margin: 12px 0 0; font-size: .9rem; text-align: left; }
  .envoyer { width: 100%; margin-top: 18px; padding: 13px; border: 0; border-radius: 12px; background: var(--accent); color: var(--accent-ink); font: inherit; font-weight: 700; font-size: 1rem; cursor: pointer; }
  .envoyer:disabled { opacity: .7; cursor: wait; }
  .aide { font-size: .84rem; color: var(--muted); margin: 14px 0 0; }
  .maquette { font-size: .82rem; color: var(--muted); margin: 14px 0 0; text-align: left; background: var(--surface-2); border-radius: 10px; padding: 10px 12px; }
  .installer { margin-top: 18px; }
  .btn-install { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; }
  .btn-install svg { width: 19px; height: 19px; }
  .aide-ios { font-size: .88rem; text-align: left; background: var(--surface-2); border-radius: 12px; padding: 12px 14px; margin: 10px 0 0; }
  [hidden] { display: none !important; }
</style>
