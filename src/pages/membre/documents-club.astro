---
// Documents du club (admin) : ajouter, modifier, remplacer ou supprimer les documents de l'onglet Préparer.
// Rangé sur Cloudflare (base D1, privée derrière le mot de passe membres) ; seul le mot de passe admin (MOT_DE_PASSE_ADMIN) est demandé.
// Chaque changement garde la version d'avant dans l'historique, d'où elle peut être remise en ligne.
import { getCollection } from 'astro:content';
import MembreApp from '../../layouts/MembreApp.astro';
import Logo from '../../components/Logo.astro';
import { url, asset } from '../../lib/utils';
import { baseClub } from '../../lib/docs-club';
const docs = (await getCollection('documents')).map((d) => ({ id: d.id, ...d.data }));
const base = baseClub(docs, (d) => (d.fichier ? asset(d.fichier) : d.lien || ''));
---
<MembreApp title="Documents du club">
  <div class="ecran" id="ecran" data-api={url('/membre/api/documents-club')}>
    <header class="haut">
      <a href={url('/membre/#admin')} class="retour" aria-label="Retour à l'administration">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
      </a>
      <Logo class="logo" />
      <span>Documents du club</span>
    </header>

    <main class="corps">
      <div class="gauche">
      <form class="carte" id="form" novalidate>
        <div class="f-tete">
          <h1 id="f-titre">Ajouter un document</h1>
          <button type="button" class="annuler" id="annuler" hidden>Annuler</button>
        </div>

        <label class="lbl" for="rubrique">Rubrique</label>
        <select id="rubrique" required>
          <option value="">Choisir…</option>
        </select>

        <label class="lbl" for="titre">Nom du document</label>
        <input id="titre" type="text" maxlength="120" placeholder="ex. Mémo sécurité" />

        <label class="lbl" for="descr">Description <i>(facultatif)</i></label>
        <input id="descr" type="text" maxlength="200" placeholder="ex. Consignes de sécurité du club." />

        <div class="choix" role="tablist" aria-label="Fichier ou lien">
          <button type="button" role="tab" data-mode="fichier" aria-selected="true">Fichier</button>
          <button type="button" role="tab" data-mode="lien" aria-selected="false">Lien internet</button>
        </div>

        <label class="depot" id="depot" for="fichier">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5" /><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
          <b id="depot-t">Glissez le fichier ici</b>
          <small id="depot-s">ou touchez pour le choisir (PDF, photo, tableur…)</small>
          <input type="file" id="fichier" accept=".pdf,image/*,video/*,.doc,.docx,.xls,.xlsx,.odt,.ods" />
        </label>
        <div id="z-lien" hidden>
          <input id="lien" type="url" inputmode="url" placeholder="https://…" />
        </div>
        <p class="garde" id="garde" hidden>Sans nouveau fichier, le document garde son fichier actuel.</p>

        <label class="lbl" for="mdp">Mot de passe admin</label>
        <input id="mdp" type="password" autocomplete="current-password" />

        <p class="erreur" id="erreur" role="alert" hidden></p>
        <p class="ok" id="ok" role="status" hidden></p>
        <button class="pri" type="submit" id="envoyer">Mettre en ligne</button>
      </form>

      <section class="carte" id="c-rub">
        <h2>Rubriques</h2>
        <p class="sous">Renommer, ranger avec les flèches, supprimer une rubrique vide ou en créer une.</p>
        <ul class="rubs" id="rubs"></ul>
        <div class="ajout-rub">
          <input id="nouvelle" type="text" maxlength="40" placeholder="Nouvelle rubrique" />
          <button type="button" id="ajouter-rub">Ajouter</button>
        </div>
        <p class="erreur" id="rub-erreur" role="alert" hidden></p>
        <p class="ok" id="rub-ok" role="status" hidden></p>
        <button class="pri" type="button" id="enregistrer-rub" disabled>Enregistrer les rubriques</button>
      </section>
      </div>

      <div class="droite">
        <section class="carte">
          <h2>Documents en ligne</h2>
          <p class="sous" id="etat">Chargement…</p>
          <div id="liste"></div>
        </section>
        <section class="carte" id="c-histo" hidden>
          <h2>Historique</h2>
          <p class="sous">Versions remplacées et documents supprimés. Ils ne sont plus visibles par les membres.</p>
          <ul class="docs" id="histo"></ul>
        </section>
      </div>
    </main>
  </div>
  <script type="application/json" id="base" set:html={JSON.stringify(base)} />
</MembreApp>

<script>
  import { rubriquesDe, fusion, type BaseClub, type DocClub, type LigneClub, type Rubrique } from '../../lib/docs-club';
  const API = document.getElementById('ecran')!.dataset.api!;
  const BASE: BaseClub[] = JSON.parse(document.getElementById('base')!.textContent || '[]');
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const rubrique = $<HTMLSelectElement>('rubrique'), titre = $<HTMLInputElement>('titre'), descr = $<HTMLInputElement>('descr');
  const fichier = $<HTMLInputElement>('fichier'), lien = $<HTMLInputElement>('lien'), mdp = $<HTMLInputElement>('mdp');
  const erreur = $('erreur'), ok = $('ok'), envoyer = $<HTMLButtonElement>('envoyer'), depot = $('depot');
  const esc = (t: string) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const montrer = (el: HTMLElement, t: string) => { el.textContent = t; el.hidden = !t; };
  let rubriques: Rubrique[] = rubriquesDe(null);
  const nomRub = (id: string) => rubriques.find((r) => r.id === id)?.nom || 'Autres documents';
  const jour = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Europe/Paris' });
  try { mdp.value = localStorage.getItem('acbt-admin-alertes') || ''; } catch { /* privé */ }

  let docs: DocClub[] = [];
  const remplirSelect = () => {
    const v = rubrique.value;
    rubrique.innerHTML = '<option value="">Choisir…</option>' + rubriques.map((r) => `<option value="${esc(r.id)}">${esc(r.nom)}</option>`).join('');
    rubrique.value = rubriques.some((r) => r.id === v) ? v : '';
  };
  let choisi: File | null = null;
  let mode: 'fichier' | 'lien' = 'fichier';
  let edite: DocClub | null = null;

  const choisirMode = (m: 'fichier' | 'lien') => {
    mode = m;
    document.querySelectorAll<HTMLButtonElement>('.choix button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mode === m)));
    depot.hidden = m !== 'fichier';
    $('z-lien').hidden = m !== 'lien';
    $('garde').hidden = !(edite && m === 'fichier' && edite.genre !== 'LIEN');
  };
  document.querySelectorAll<HTMLButtonElement>('.choix button').forEach((b) => b.addEventListener('click', () => choisirMode(b.dataset.mode as 'fichier' | 'lien')));

  const viderFichier = () => {
    choisi = null; fichier.value = '';
    $('depot-t').textContent = edite ? 'Remplacer le fichier (facultatif)' : 'Glissez le fichier ici';
    $('depot-s').textContent = 'ou touchez pour le choisir (PDF, photo, tableur…)';
    depot.classList.remove('plein');
  };
  const prendre = (f: File | undefined | null) => {
    if (!f) return;
    choisi = f;
    $('depot-t').textContent = f.name;
    $('depot-s').textContent = `${(f.size / 1_048_576).toFixed(1).replace('.', ',')} Mo · touchez pour changer`;
    depot.classList.add('plein');
    if (!titre.value.trim()) titre.value = f.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').replace(/^./, (c) => c.toUpperCase());
  };
  fichier.addEventListener('change', () => prendre(fichier.files?.[0]));
  ['dragenter', 'dragover'].forEach((e) => depot.addEventListener(e, (ev) => { ev.preventDefault(); depot.classList.add('survol'); }));
  ['dragleave', 'drop'].forEach((e) => depot.addEventListener(e, () => depot.classList.remove('survol')));
  depot.addEventListener('drop', (ev) => { ev.preventDefault(); prendre((ev as DragEvent).dataTransfer?.files?.[0]); });

  const baseDe = (cle: string) => BASE.find((b) => b.cle === cle) || null;

  const editer = (d: DocClub | null) => {
    edite = d;
    $('f-titre').textContent = d ? 'Modifier le document' : 'Ajouter un document';
    $('annuler').hidden = !d;
    envoyer.textContent = d ? 'Enregistrer' : 'Mettre en ligne';
    rubrique.value = d?.rubrique || '';
    titre.value = d?.titre || '';
    descr.value = d?.descr || '';
    lien.value = d && d.genre === 'LIEN' ? d.href : '';
    montrer(erreur, ''); montrer(ok, '');
    viderFichier();
    choisirMode(d && d.genre === 'LIEN' ? 'lien' : 'fichier');
    if (d) $('form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  $('annuler').addEventListener('click', () => editer(null));

  $('form').addEventListener('submit', async (e) => {
    e.preventDefault();
    montrer(ok, '');
    const l = lien.value.trim();
    const manque = !rubrique.value ? 'Choisissez la rubrique.' : !titre.value.trim() ? 'Indiquez le nom du document.'
      : mode === 'lien' && !/^https?:\/\/\S+$/i.test(l) ? 'Indiquez l’adresse du lien (elle commence par https://).'
      : mode === 'fichier' && !choisi && !(edite && edite.genre !== 'LIEN') ? 'Choisissez un fichier.'
      : !mdp.value ? 'Indiquez le mot de passe admin.' : '';
    if (manque) { montrer(erreur, manque); return; }
    montrer(erreur, '');
    envoyer.disabled = true; const avant = envoyer.textContent; envoyer.textContent = 'Envoi…';
    const f = new FormData();
    f.append('motDePasse', mdp.value); f.append('rubrique', rubrique.value);
    f.append('titre', titre.value.trim()); f.append('descr', descr.value.trim());
    if (edite) { f.append('cle', edite.cle); const b = baseDe(edite.cle); if (b) f.append('base', JSON.stringify(b)); }
    if (mode === 'lien') f.append('lien', l);
    else if (choisi) f.append('fichier', choisi);
    const r = await fetch(API, { method: 'POST', credentials: 'same-origin', body: f }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : {};
    envoyer.disabled = false; envoyer.textContent = avant;
    if (!r || !r.ok) { montrer(erreur, d.erreur || 'Envoi impossible (pas de réseau ?).'); return; }
    try { localStorage.setItem('acbt-admin-alertes', mdp.value); } catch { /* privé */ }
    const msg = `« ${d.titre} » est en ligne dans « ${nomRub(rubrique.value)} ».`;
    editer(null);
    montrer(ok, msg);
    charger();
  });

  const ligne = (d: DocClub, histo = false) => {
    const l = d.ligne;
    const info = histo && l
      ? `${esc(nomRub(d.rubrique))} · ${l.etat === 'retire' ? 'supprimé' : 'remplacé'} le ${jour(l.change || l.cree)}`
      : `${esc(d.genre)}${d.descr ? ' · ' + esc(d.descr) : ''}`;
    const actions = histo
      ? `<button type="button" class="b-remettre" data-action="restaurer" data-id="${esc(l!.id)}">Remettre en ligne</button>
         <button type="button" class="b-suppr" data-action="effacer" data-id="${esc(l!.id)}">Effacer</button>`
      : `<button type="button" data-modifier="${esc(d.cle)}">Modifier</button>
         <button type="button" class="b-suppr" data-action="retirer" data-cle="${esc(d.cle)}">Supprimer</button>`;
    return `<li${histo ? ' class="ancien"' : ''}>
      <a href="${esc(d.href)}" target="_blank" rel="noopener"><b>${esc(d.titre)}</b><small>${info}</small></a>
      <span class="act"><a href="${esc(d.href)}" target="_blank" rel="noopener">Ouvrir</a>${actions}</span></li>`;
  };

  async function charger() {
    try {
      const rep = await (await fetch(API, { credentials: 'same-origin', cache: 'no-store' })).json();
      const lignes: LigneClub[] = rep.lignes || [];
      rubriques = rubriquesDe(rep.rubriques);
      if (!rubModifie) { brouillon = rubriques.map((r) => ({ ...r })); afficherRubs(); }
      remplirSelect();
      const f = fusion(BASE, lignes, API);
      docs = f.docs;
      montrer($('etat'), docs.length ? '' : 'Aucun document.');
      const connues = new Set(rubriques.map((r) => r.id));
      const groupes = [...rubriques.map((r) => ({ nom: r.nom, ici: docs.filter((d) => d.rubrique === r.id) })),
        { nom: 'Autres documents (rubrique supprimée)', ici: docs.filter((d) => !connues.has(d.rubrique)) }];
      $('liste').innerHTML = groupes.map((g) => g.ici.length ? `<h3>${esc(g.nom)} <span>${g.ici.length}</span></h3><ul class="docs">${g.ici.map((d) => ligne(d)).join('')}</ul>` : '').join('');
      afficherRubs();
      $('c-histo').hidden = !f.historique.length;
      $('histo').innerHTML = f.historique.map((d) => ligne(d, true)).join('');
    } catch { montrer($('etat'), 'Impossible de charger la liste (pas de réseau ?).'); }
  }

  const QUESTION: Record<string, string> = {
    retirer: 'Supprimer ce document de la liste des membres ? Il restera dans l’historique, d’où il pourra être remis en ligne.',
    restaurer: 'Remettre cette version en ligne ? La version actuelle passera dans l’historique.',
    effacer: 'Effacer définitivement cette version ? Elle ne pourra pas être récupérée.',
  };
  document.querySelector('.droite')!.addEventListener('click', async (e) => {
    const m = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-modifier]');
    if (m) { editer(docs.find((d) => d.cle === m.dataset.modifier) || null); return; }
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
    if (!b) return;
    if (!mdp.value) { montrer(erreur, 'Indiquez le mot de passe admin.'); mdp.focus(); return; }
    if (!confirm(QUESTION[b.dataset.action!])) return;
    b.disabled = true;
    const corps: Record<string, unknown> = { action: b.dataset.action, motDePasse: mdp.value };
    if (b.dataset.cle) { corps.cle = b.dataset.cle; const base = baseDe(b.dataset.cle); if (base) corps.base = base; }
    if (b.dataset.id) corps.id = b.dataset.id;
    const r = await fetch(API, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corps) }).catch(() => null);
    if (!r || !r.ok) { b.disabled = false; montrer(erreur, (r && (await r.json().catch(() => ({}))).erreur) || 'Action impossible (pas de réseau ?).'); return; }
    try { localStorage.setItem('acbt-admin-alertes', mdp.value); } catch { /* privé */ }
    montrer(erreur, '');
    if (edite && b.dataset.cle === edite.cle) editer(null);
    charger();
  });

  // Rubriques : modifiées ici, enregistrées d'un coup
  let brouillon: Rubrique[] = rubriques.map((r) => ({ ...r }));
  let rubModifie = false;
  const rubErreur = $('rub-erreur'), rubOk = $('rub-ok'), btnRub = $<HTMLButtonElement>('enregistrer-rub');
  const nbDocs = (id: string) => docs.filter((d) => d.rubrique === id).length;
  const modifie = () => { rubModifie = true; btnRub.disabled = false; montrer(rubOk, ''); };
  function afficherRubs() {
    $('rubs').innerHTML = brouillon.map((r, i) => {
      const n = nbDocs(r.id);
      return `<li data-i="${i}">
        <input type="text" maxlength="40" value="${esc(r.nom)}" aria-label="Nom de la rubrique" />
        <span class="r-nb">${n} doc${n > 1 ? 's' : ''}</span>
        <button type="button" data-r="haut" aria-label="Monter" ${i === 0 ? 'disabled' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg></button>
        <button type="button" data-r="bas" aria-label="Descendre" ${i === brouillon.length - 1 ? 'disabled' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button>
        <button type="button" data-r="suppr" class="b-suppr" ${n ? `disabled title="Déplacez ou supprimez d’abord ses documents"` : ''}>Supprimer</button>
      </li>`;
    }).join('');
  }
  $('rubs').addEventListener('input', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-i]');
    if (!li) return;
    brouillon[+li.dataset.i!].nom = (e.target as HTMLInputElement).value;
    modifie();
  });
  $('rubs').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-r]');
    const li = b?.closest<HTMLElement>('li[data-i]');
    if (!b || !li) return;
    const i = +li.dataset.i!;
    if (b.dataset.r === 'haut' && i > 0) [brouillon[i - 1], brouillon[i]] = [brouillon[i], brouillon[i - 1]];
    else if (b.dataset.r === 'bas' && i < brouillon.length - 1) [brouillon[i + 1], brouillon[i]] = [brouillon[i], brouillon[i + 1]];
    else if (b.dataset.r === 'suppr') {
      if (nbDocs(brouillon[i].id)) return;
      if (brouillon.length === 1) { montrer(rubErreur, 'Gardez au moins une rubrique.'); return; }
      brouillon.splice(i, 1);
    }
    modifie(); afficherRubs();
  });
  $('ajouter-rub').addEventListener('click', () => {
    const champ = $<HTMLInputElement>('nouvelle');
    const nom = champ.value.trim();
    if (!nom) { champ.focus(); return; }
    const racine = nom.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 30) || 'rubrique';
    let id = racine, k = 2;
    while (brouillon.some((r) => r.id === id) || rubriques.some((r) => r.id === id)) id = `${racine}-${k++}`;
    brouillon.push({ id, nom });
    champ.value = '';
    modifie(); afficherRubs();
  });
  $<HTMLInputElement>('nouvelle').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); $('ajouter-rub').click(); } });
  btnRub.addEventListener('click', async () => {
    montrer(rubOk, '');
    if (brouillon.some((r) => !r.nom.trim())) { montrer(rubErreur, 'Chaque rubrique doit avoir un nom.'); return; }
    if (!mdp.value) { montrer(rubErreur, 'Indiquez le mot de passe admin (dans le formulaire).'); mdp.focus(); return; }
    montrer(rubErreur, '');
    btnRub.disabled = true; btnRub.textContent = 'Envoi…';
    const liste = brouillon.map((r) => ({ id: r.id, nom: r.nom.trim() }));
    const r = await fetch(API, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'rubriques', liste, motDePasse: mdp.value }) }).catch(() => null);
    const d = r ? await r.json().catch(() => ({})) : {};
    btnRub.textContent = 'Enregistrer les rubriques';
    if (!r || !r.ok) { btnRub.disabled = false; montrer(rubErreur, d.erreur || 'Envoi impossible (pas de réseau ?).'); return; }
    try { localStorage.setItem('acbt-admin-alertes', mdp.value); } catch { /* privé */ }
    rubModifie = false;
    montrer(rubOk, 'Rubriques enregistrées.');
    charger();
  });

  remplirSelect();
  afficherRubs();
  editer(null);
  charger();
</script>

<style>
  .ecran { min-height: 100svh; display: flex; flex-direction: column; background: var(--bg); }
  .haut { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 10px; min-height: calc(54px + env(safe-area-inset-top, 0px)); padding: 0 16px 0 8px; padding-top: env(safe-area-inset-top, 0px); background: var(--bar); color: var(--bar-ink); }
  .retour { display: grid; place-items: center; width: 34px; height: 34px; color: var(--bar-ic); }
  .retour svg { width: 22px; height: 22px; }
  .haut :global(.logo) { --logo-h: 40px; --logo-rouge: var(--bar-rouge); color: var(--bar-ink); }
  .haut span { font-weight: 800; font-size: 1.05rem; }
  .corps { flex: 1; width: 100%; max-width: 680px; margin: 0 auto; padding: 18px 16px 40px; display: grid; gap: 14px; align-content: start; }
  .gauche { display: grid; gap: 14px; align-content: start; min-width: 0; }
  .rubs { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; }
  .rubs :global(li) { display: flex; align-items: center; gap: 6px; }
  .rubs :global(input) { flex: 1; min-width: 0; min-height: 42px; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; font: inherit; background: var(--surface-2, var(--surface)); color: var(--ink); box-sizing: border-box; }
  .rubs :global(.r-nb) { flex: none; font-size: .74rem; color: var(--muted); font-weight: 700; min-width: 44px; text-align: right; }
  .rubs :global(button) { flex: none; height: 42px; min-width: 42px; display: grid; place-items: center; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-weight: 700; font-size: .8rem; border-radius: 8px; padding: 0 10px; cursor: pointer; }
  .rubs :global(button svg) { width: 18px; height: 18px; }
  .rubs :global(button:disabled) { opacity: .4; cursor: default; }
  .rubs :global(.b-suppr) { border-color: var(--bad-line); background: var(--bad-bg); color: var(--bad); }
  @media (max-width: 560px) { .rubs :global(li) { flex-wrap: wrap; } .rubs :global(input) { flex-basis: 100%; } .rubs :global(.r-nb) { margin-right: auto; text-align: left; } }
  .ajout-rub { display: flex; gap: 8px; margin-top: 12px; }
  .ajout-rub input { flex: 1; min-width: 0; }
  .ajout-rub button { flex: none; border: 1px solid var(--accent-line); background: var(--accent-soft); color: var(--accent-text); font: inherit; font-weight: 800; border-radius: 10px; padding: 0 16px; cursor: pointer; }
  .pri:disabled:not(:has(*)) { opacity: .45; cursor: default; }
  .droite { display: grid; gap: 14px; align-content: start; min-width: 0; }
  .carte { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px 18px; min-width: 0; }
  .f-tete { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  h1 { font-size: 1.25rem; margin: 0; }
